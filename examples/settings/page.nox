from aura.controls import Button
from aura.foundation.color import COLOR_ACCENT, COLOR_BUTTON, COLOR_BUTTON_TEXT, COLOR_TEXT, rgb
from aura.foundation.insets import insets_all, EdgeInsets
from aura.layout import ColoredBox, Column, Expanded, Padding, Row, SafeArea, SizedBox, Stack
from aura.layout.stack import Positioned
from aura.layout.flex import CROSS_CENTER, CROSS_STRETCH, MAIN_MIN
from aura.layout.scrollbar import Scrollbar
from aura.layout.virtual_list import ItemSource, ScrollController, VirtualList
from aura.text import Text, TextEditingController, TextField
from aura.text.measure import measure_height
from aura.widgets import BuildContext, State, StatefulWidget, Theme, ThemeData, Widget
from aura.widgets.theme import ColorScheme, Typography, default_scheme
from aura.widgets.type_ids import alloc_type_id
from aura.window import window_height, window_scale, window_title, window_width

TYPE_SETTINGS: int = alloc_type_id()

COLOR_PANEL: int = rgb(38, 36, 33)
COLOR_MUTED: int = rgb(168, 162, 154)

name: TextEditingController = TextEditingController("Harbor")


def number_text(value: float) -> str:
    text: str = str(value)
    if len(text) >= 2:
        if text[len(text) - 2:len(text)] == ".0":
            return text[0:len(text) - 2]
    return text


def labeled_row(label: str, value: str) -> Widget:
    return Row([
        SizedBox(132.0, None, Text(label, color=COLOR_MUTED)),
        Text(value, color=COLOR_TEXT),
    ], cross_align=CROSS_CENTER, main_size=MAIN_MIN, spacing=12.0)


def _line(size: float, weight: int) -> float:
    return measure_height(size, weight, "")


def header_extent() -> float:
    return _line(32.0, 400) + 8.0 + _line(16.0, 400) + 28.0


def panel_extent() -> float:
    line: float = _line(16.0, 400)
    window: float = _line(14.0, 600)
    button: float = _line(16.0, 600) + 20.0
    field: float = line + 16.0
    inner: float = window + line * 4.0 + 8.0 + field + button + 14.0 * 7.0
    return inner + 48.0 + 16.0


class SettingsSource(ItemSource):
    on_toggle: () -> None

    def __init__(self, on_toggle: () -> None) -> None:
        self.on_toggle = on_toggle

    def count(self) -> int:
        return 2

    def revision(self) -> int:
        return int(window_width()) + int(window_height()) * 10000

    def keep_alive(self, index: int) -> bool:
        return True

    def extent_at(self, index: int, width: float) -> float:
        if index == 0:
            return header_extent()
        return panel_extent()

    def widget_at(self, index: int) -> Widget:
        if index == 0:
            return Column([
                Text("Settings", font_size=32.0, color=rgb(28, 27, 25)),
                SizedBox(None, 8.0),
                Text("Appearance follows the theme."),
                SizedBox(None, 28.0),
            ], cross_align=CROSS_STRETCH, main_size=MAIN_MIN)
        size: str = number_text(window_width()) + " × " + number_text(window_height())
        return ColoredBox(COLOR_PANEL, Padding(EdgeInsets(24.0, 24.0, 24.0, 24.0), Column([
            Text("Window", font_size=14.0, weight=600, color=COLOR_ACCENT),
            labeled_row("Title", window_title()),
            labeled_row("Size", size),
            labeled_row("Scale", number_text(window_scale())),
            SizedBox(None, 8.0),
            Text("Display name", color=COLOR_TEXT),
            TextField(name),
            Row([
                Button("Switch ink", self.on_toggle, color=COLOR_BUTTON_TEXT, background=COLOR_BUTTON),
            ], cross_align=CROSS_CENTER, main_size=MAIN_MIN),
        ], spacing=14.0, cross_align=CROSS_STRETCH, main_size=MAIN_MIN)))


class SettingsState(State):
    text_color: int
    scroll: ScrollController
    listing: VirtualList

    def toggle_theme(self) -> None:
        if self.text_color == COLOR_ACCENT:
            self.text_color = COLOR_TEXT
        else:
            self.text_color = COLOR_ACCENT
        self.invalidate()

    def __init__(self) -> None:
        super().__init__()
        self.text_color = COLOR_ACCENT
        self.scroll = ScrollController()
        self.listing = VirtualList(SettingsSource(self.toggle_theme), 48.0, self.scroll)

    def build(self, context: BuildContext) -> Widget:
        scheme: ColorScheme = default_scheme()
        scheme.text = self.text_color
        return Theme(ThemeData(scheme, Typography()), SafeArea(Column([
            Expanded(Stack([
                self.listing,
                Positioned(Scrollbar(self.scroll, None, 28.0), top=0.0, bottom=0.0, right=2.0),
            ])),
        ], cross_align=CROSS_STRETCH), minimum=insets_all(24.0)))


class SettingsPage(StatefulWidget):
    def __init__(self) -> None:
        super().__init__(TYPE_SETTINGS, None)

    def create_state(self) -> State:
        return SettingsState()
