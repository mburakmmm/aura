from aura.controls import Button
from aura.foundation.color import COLOR_BUTTON, COLOR_BUTTON_TEXT, COLOR_FIELD, COLOR_TEXT, rgb
from aura.foundation.insets import EdgeInsets, insets_all
from aura.layout import ColoredBox, Column, Expanded, Padding, Row, SizedBox
from aura.layout.flex import CROSS_CENTER, CROSS_STRETCH, MAIN_MIN
from aura.layout.scrollbar import Scrollbar
from aura.layout.virtual_list import ItemSource, ScrollController, VirtualList
from aura.text import Text, TextEditingController, TextField
from aura.text.measure import measure_height, wrap_text
from aura.widgets import BuildContext, State, StatefulWidget, StatelessWidget, Widget
from aura.widgets.type_ids import alloc_type_id

TYPE_CHAT: int = alloc_type_id()
TYPE_MESSAGE: int = alloc_type_id()

ROW_PAD_X: float = 12.0
ROW_PAD_Y: float = 8.0
ROW_GAP: float = 8.0
COLOR_PANEL: int = rgb(38, 36, 33)
LONG_MESSAGE: str = "The harbor is quiet after the rain, and the notebook stayed open on the desk while the light moved across the page."

messages: list[str] = []
message_revision: int = 0
draft: TextEditingController = TextEditingController("")
scroll: ScrollController = ScrollController()
scroll.follow_end = 1


def push_message(text: str) -> None:
    messages.append(text)
    message_revision = message_revision + 1


def message_extent(text: str, width: float) -> float:
    inner: float = width - ROW_PAD_X * 2.0
    if inner < 1.0:
        inner = 1.0
    count: int = len(wrap_text(text, inner, 16.0, 400, ""))
    if count < 1:
        count = 1
    return measure_height(16.0, 400, "") * float(count) + ROW_PAD_Y * 2.0 + ROW_GAP


class MessageLine(StatelessWidget):
    value: str

    def __init__(self, value: str) -> None:
        super().__init__(TYPE_MESSAGE, None)
        self.value = value

    def build(self, context: BuildContext) -> Widget:
        return Column([
            ColoredBox(COLOR_FIELD, Padding(EdgeInsets(ROW_PAD_X, ROW_PAD_Y, ROW_PAD_X, ROW_PAD_Y), Text(self.value, color=COLOR_TEXT))),
            SizedBox(None, ROW_GAP),
        ], cross_align=CROSS_STRETCH, main_size=MAIN_MIN)


class ChatSource(ItemSource):
    def count(self) -> int:
        return len(messages)

    def revision(self) -> int:
        return message_revision

    def widget_at(self, index: int) -> Widget:
        return MessageLine(messages[index])

    def extent_at(self, index: int, width: float) -> float:
        return message_extent(messages[index], width)

    def keep_alive(self, index: int) -> bool:
        return False


class ChatState(State):
    listing: VirtualList

    def __init__(self) -> None:
        super().__init__()
        self.listing = VirtualList(ChatSource(), 36.0, scroll)

    def send(self) -> None:
        text: str = draft.text
        if text == "":
            return
        push_message(text)
        draft.anchor = 0
        draft.cursor = len(text)
        draft.insert("")
        self.invalidate()

    def build(self, context: BuildContext) -> Widget:
        return Padding(insets_all(24.0), Column([
            Text("Chat", font_size=28.0, color=COLOR_TEXT),
            SizedBox(None, 16.0),
            Expanded(Row([
                Expanded(self.listing),
                Scrollbar(scroll),
            ], cross_align=CROSS_STRETCH)),
            SizedBox(None, 16.0),
            ColoredBox(COLOR_PANEL, Padding(EdgeInsets(16.0, 12.0, 16.0, 12.0), Row([
                Expanded(TextField(draft)),
                Button("Send", self.send, color=COLOR_BUTTON_TEXT, background=COLOR_BUTTON),
            ], spacing=12.0, cross_align=CROSS_CENTER))),
        ], cross_align=CROSS_STRETCH))


class ChatPage(StatefulWidget):
    def __init__(self) -> None:
        super().__init__(TYPE_CHAT, None)

    def create_state(self) -> State:
        return ChatState()
