from aura.foundation.insets import insets_all
from aura.layout import Column, Expanded, Padding
from aura.layout.flex import CROSS_STRETCH
from aura.text import Text, TextEditingController, TextField
from aura.widgets import BuildContext, StatelessWidget, Widget
from aura.widgets.type_ids import alloc_type_id

TYPE_NOTES: int = alloc_type_id()

SENTENCE: str = "The harbor is quiet after the rain, and the notebook stayed open on the desk while the light moved across the page."
SECOND: str = "Filed under today. Bring it back when the light changes."
DOCUMENT: str = SENTENCE + "\n" + SECOND

document: TextEditingController = TextEditingController(DOCUMENT)
document.collapse(0)


class NotesPage(StatelessWidget):
    def __init__(self) -> None:
        super().__init__(TYPE_NOTES, None)

    def build(self, context: BuildContext) -> Widget:
        return Padding(insets_all(32.0), Column([
            Text("Notes", font_size=32.0),
            Expanded(TextField(document, multiline=1)),
        ], spacing=20.0, cross_align=CROSS_STRETCH))
