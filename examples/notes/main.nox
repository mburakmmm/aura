from aura.app import run_app
from aura.input.events import EVENT_IME_MARK, EVENT_POINTER_DOWN, EVENT_POINTER_MOVE, EVENT_POINTER_UP
from aura.platform.macos import clipboard_get, clipboard_set, post_mouse
from aura.rendering.render_object import RenderBox
from aura.runtime.binding import Binding
from aura.text.field import painted_text, selection_row_count
from aura.text.measure import TextLine, layout_lines, measure_height, measure_width, wrap_text
from examples.notes.page import SENTENCE, NotesPage, document
from nox.os import arg, arg_count


def find_field(box: RenderBox) -> RenderBox | None:
    if box.semantics_role == "text-field":
        return box
    only: RenderBox | None = box.only_child
    found: RenderBox | None = None
    i: int = 0
    if only is not None:
        found = find_field(only)
        if found is not None:
            return found
    while i < len(box.children):
        found = find_field(box.children[i])
        if found is not None:
            return found
        i = i + 1
    return None


def contains(text: str, needle: str) -> int:
    width: int = len(needle)
    limit: int = len(text) - width
    i: int = 0
    if width == 0:
        return 1
    while i <= limit:
        if text[i:i + width] == needle:
            return 1
        i = i + 1
    return 0


def stop(binding: Binding, kept: str, message: str) -> None:
    clipboard_set(kept)
    binding.close()
    raise Exception(message)


def self_check() -> None:
    kept: str = clipboard_get()
    binding: Binding = Binding(800, 600, "Notes", 0)
    binding.mount(NotesPage())
    binding.frame()
    field: RenderBox | None = find_field(binding.pump.view)
    if field is None:
        stop(binding, kept, "missing notes field")
        return
    if field.width < 400.0:
        stop(binding, kept, "field does not fill the page")
        return
    line_h: float = measure_height(16.0, 400, "")
    origin_x: float = field.absolute_x() + 8.0
    origin_y: float = field.absolute_y() + 8.0
    content: float = field.width - 16.0
    wrapped: list[TextLine] = layout_lines(SENTENCE, content, 16.0, 400, "")
    if len(wrapped) != 2:
        stop(binding, kept, "sentence did not wrap to two lines")
        return
    end_x: float = origin_x + measure_width(wrapped[1].text, 16.0, 400, "") + 4.0
    end_y: float = origin_y + line_h + 2.0
    post_mouse(binding.surface.handle, EVENT_POINTER_DOWN, origin_x, origin_y + 2.0)
    post_mouse(binding.surface.handle, EVENT_POINTER_MOVE, end_x, end_y)
    post_mouse(binding.surface.handle, EVENT_POINTER_UP, end_x, end_y)
    binding.frame()
    if document.selected_text() != SENTENCE:
        stop(binding, kept, "selection is not the sentence")
        return
    if selection_row_count(document.target_id) != 2:
        stop(binding, kept, "selection is not on two lines")
        return
    document.copy()
    if clipboard_get() != SENTENCE:
        stop(binding, kept, "copy did not write the sentence")
        return
    second_y: float = origin_y + line_h * 2.0 + 2.0
    post_mouse(binding.surface.handle, EVENT_POINTER_DOWN, origin_x + 1.0, second_y)
    post_mouse(binding.surface.handle, EVENT_POINTER_UP, origin_x + 1.0, second_y)
    binding.frame()
    document.paste()
    binding.frame()
    marker: str = "\n" + SENTENCE
    if contains(document.text, marker) != 1:
        stop(binding, kept, "paste did not land after the line break")
        return
    if document.text[0:len(SENTENCE) + 1] != SENTENCE + "\n":
        stop(binding, kept, "first paragraph changed")
        return
    binding.pump.dispatch(EVENT_IME_MARK, 0.0, 0.0, 0, "Q")
    binding.frame()
    if contains(document.text, "Q") == 1:
        stop(binding, kept, "composition was written into the document")
        return
    shown: str = document.text[0:document.cursor] + "Q" + document.text[document.cursor:len(document.text)]
    if painted_text(document.target_id) != _join(wrap_text(shown, content, 16.0, 400, "")):
        stop(binding, kept, "composition is not at the caret")
        return
    binding.insert_text("Q")
    binding.frame()
    if document.composing != "":
        stop(binding, kept, "commit left a composition")
        return
    if contains(document.text, "\n" + SENTENCE + "Q") != 1:
        stop(binding, kept, "commit did not land in the second paragraph")
        return
    clipboard_set(kept)
    binding.close()
    print("notes self-check ok")


def _join(lines: list[str]) -> str:
    joined: str = ""
    i: int = 0
    while i < len(lines):
        if i > 0:
            joined = joined + "\n"
        joined = joined + lines[i]
        i = i + 1
    return joined


def wants_self_check() -> bool:
    i: int = 0
    while i < arg_count():
        if arg(i) == "--self-check":
            return True
        i = i + 1
    return False


if wants_self_check():
    self_check()
else:
    run_app(NotesPage(), "Notes")
