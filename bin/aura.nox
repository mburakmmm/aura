from cli.command import VERSION, tool_script, usage, write_project
from nox.os import arg, arg_count, current_dir, exit
from nox.path import join
from nox.process import Command, Output, ProcessError


def argument(index: int) -> str:
    if index >= arg_count():
        return ""
    return arg(index)


def run_python(program: str, script: str) -> int:
    command: Command = Command(program)
    command.arg(script)
    index: int = 1
    while index < arg_count():
        command.arg(argument(index))
        index = index + 1
    out: Output = Output(0, "", "")
    try:
        out = command.run()
    except ProcessError:
        return -1
    if out.stdout != "":
        print(out.stdout)
    if out.stderr != "":
        print(out.stderr)
    return out.status


def forward(script: str) -> None:
    if script == "":
        print("aura tools were not found. Run this inside the Aura checkout or install the package with noxc.")
        exit(2)
    print("aura " + argument(1))
    status: int = run_python("python3", script)
    if status == -1:
        status = run_python("python", script)
    if status == -1:
        print("python3 is required")
        exit(1)
    exit(status)


def dispatch() -> None:
    command: str = argument(1)
    if command == "" or command == "help" or command == "--help":
        print(usage())
        exit(0)
    if command == "version" or command == "--version":
        print(VERSION)
        exit(0)
    if command == "new":
        name: str = argument(2)
        if name == "" or argument(3) != "":
            print(usage())
            exit(2)
        error: str = write_project(join(current_dir(), name), name)
        if error != "":
            print(error)
            exit(2)
        print("created " + name)
        print("cd " + name)
        print("noxc fetch")
        print("aura run")
        exit(0)
    if command == "doctor" or command == "devices" or command == "run" or command == "build" or command == "test" or command == "clean":
        forward(tool_script(current_dir()))
    print(usage())
    exit(2)


dispatch()
