from aura.graphics.canvas import Canvas
from aura.foundation.insets import EdgeInsets
from aura.foundation.window_metrics import TEXT_DIRECTION_RTL, CutoutRect, WindowMetrics, copy_cutouts, default_window_metrics, primary_locale, resized_window_metrics
from aura.input.events import BACK_PHASE_COMMIT, EVENT_ENVIRONMENT_CHANGED, EVENT_KEY_DOWN, EVENT_KEY_UP, EVENT_LIFECYCLE, EVENT_MEMORY_PRESSURE, EVENT_METRICS, EVENT_POINTER_DOWN, EVENT_POINTER_MOVE, EVENT_POINTER_UP, EVENT_RESIZE, EVENT_SURFACE_CHANGED, EVENT_SURFACE_CREATED, EVENT_SURFACE_DESTROYED, EVENT_SYSTEM_BACK, EVENT_TEXT_EDIT, EVENT_WINDOW_FOCUS
from aura.platform.bridge import CAPABILITY_INTERACTIVE_EDGE_BACK, capabilities, clear_events, event_button, event_count, event_cutout_value, event_environment_value, event_key, event_kind, event_lifecycle_reason, event_lifecycle_state, event_memory_level, event_metrics_value, event_modifiers, event_pointer_id, event_pointer_kind, event_surface_value, event_text, event_text_edit_value, event_timestamp_ns, event_x, event_y, extent_height, extent_scale, extent_width, frame_timestamp, plugin_place, poll_events, post_ax, post_drop, post_mouse, post_text, set_active_window, should_close, surface_available, system_back_result, wait_frame
from aura.rendering.render_object import RenderBox
from aura.semantics.bridge import publish_semantics
from aura.platform.surface import HostGraphicsDevice, HostSurface
from aura.runtime.frame import FramePump
from aura.runtime.lifecycle import LIFECYCLE_RESUMED, LifecycleOwner
from aura.runtime.route_store import note_lifecycle_state
from aura.widgets.framework import Element, Widget
from aura.widgets.theme import SystemTheme, platform_theme
from aura.widgets.window_metrics import WindowMetricsScope

_METRIC_LOGICAL_WIDTH: int = 1
_METRIC_LOGICAL_HEIGHT: int = 2
_METRIC_PHYSICAL_WIDTH: int = 3
_METRIC_PHYSICAL_HEIGHT: int = 4
_METRIC_DEVICE_PIXEL_RATIO: int = 5
_METRIC_REFRESH_RATE: int = 6
_METRIC_VIEW_PADDING_LEFT: int = 7
_METRIC_VIEW_PADDING_TOP: int = 8
_METRIC_VIEW_PADDING_RIGHT: int = 9
_METRIC_VIEW_PADDING_BOTTOM: int = 10
_METRIC_VIEW_INSET_LEFT: int = 11
_METRIC_VIEW_INSET_TOP: int = 12
_METRIC_VIEW_INSET_RIGHT: int = 13
_METRIC_VIEW_INSET_BOTTOM: int = 14
_METRIC_SYSTEM_GESTURE_LEFT: int = 15
_METRIC_SYSTEM_GESTURE_TOP: int = 16
_METRIC_SYSTEM_GESTURE_RIGHT: int = 17
_METRIC_SYSTEM_GESTURE_BOTTOM: int = 18
_METRIC_ORIENTATION: int = 19
_METRIC_ROTATION_DEGREES: int = 20
_METRIC_FONT_SCALE: int = 21
_METRIC_KEYBOARD_DURATION: int = 22
_METRIC_KEYBOARD_CURVE: int = 23
_METRIC_CUTOUT_COUNT: int = 24
_ENV_BRIGHTNESS: int = 1
_ENV_HIGH_CONTRAST: int = 2
_ENV_REDUCE_MOTION: int = 3
_ENV_ACCESSIBLE_NAVIGATION: int = 4
_ENV_TEXT_DIRECTION: int = 5
_ENV_BOLD_TEXT: int = 6
_ENV_FONT_SCALE: int = 7
_CUTOUT_X: int = 1
_CUTOUT_Y: int = 2
_CUTOUT_WIDTH: int = 3
_CUTOUT_HEIGHT: int = 4
_SURFACE_GENERATION: int = 5
_TEXT_EDIT_OPERATION: int = 1
_TEXT_EDIT_GENERATION: int = 2
_TEXT_EDIT_REVISION: int = 3
_TEXT_EDIT_FIRST: int = 4
_TEXT_EDIT_SECOND: int = 5


class Binding:
    device: HostGraphicsDevice
    surface: HostSurface
    pump: FramePump
    alive: bool
    width: int
    height: int
    metrics: WindowMetrics
    metrics_revision: int
    app: Widget | None
    lifecycle: LifecycleOwner
    last_lifecycle_reason: int
    surface_available: bool
    surface_generation: int
    memory_pressure_level: int
    close_requested: int

    def __init__(self, width: int, height: int, title: str, visible: int) -> None:
        self.device = HostGraphicsDevice()
        self.surface = self.device.open_surface(width, height, title, visible)
        self.pump = FramePump()
        self.alive = True
        surface_width: float = extent_width(self.surface.handle)
        surface_height: float = extent_height(self.surface.handle)
        surface_scale: float = extent_scale(self.surface.handle)
        self.width = int(surface_width)
        self.height = int(surface_height)
        self.metrics_revision = 1
        self.metrics = default_window_metrics(surface_width, surface_height, surface_scale, self.metrics_revision)
        self.app = None
        self.lifecycle = LifecycleOwner()
        self.last_lifecycle_reason = 0
        self.surface_available = surface_available(self.surface.handle)
        self.surface_generation = 0
        self.memory_pressure_level = 0
        self.close_requested = 0
        self.pump.configure_interactive_back((capabilities(self.surface.handle) & CAPABILITY_INTERACTIVE_EDGE_BACK) != 0)
        self.pump.apply_surface_available(self.surface_available)
        set_active_window(self.surface.handle)

    def mount(self, widget: Widget) -> None:
        self.app = widget
        self.pump.mount(WindowMetricsScope(self.metrics, SystemTheme(widget)), float(self.width), float(self.height))

    def frame(self) -> None:
        stamp: float = frame_timestamp(self.surface.handle)
        if stamp >= 0.0:
            self.pump.frame_time = stamp
        self.pump.window_handle = self.surface.handle
        self._drain()
        if not self.surface_available or self.lifecycle.state != LIFECYCLE_RESUMED:
            return
        self.pump.pump(self.surface.canvas)
        _place_plugins(self.surface.handle, self.pump.view)
        publish_semantics(self.surface.handle, self.pump.pipeline.semantics)

    def post_access(self, index: int) -> None:
        post_ax(self.surface.handle, index)

    def wait(self) -> None:
        wait_frame(self.surface.handle)

    def request_close(self) -> None:
        self.close_requested = 1

    def close(self) -> None:
        if self.alive:
            mounted: Element | None = self.pump.root
            if mounted is not None:
                mounted.unmount()
                self.pump.root = None
                self.pump.view.set_only_child(None)
            self.pump.scheduler.clear()
            self.pump.owner.retire()
            set_active_window(0)
            self.surface.close()
            self.alive = False

    def is_closed(self) -> bool:
        if not self.alive:
            return True
        if self.close_requested != 0:
            return True
        return should_close(self.surface.handle)

    def insert_text(self, text: str) -> None:
        post_text(self.surface.handle, text)

    def post_file(self, x: float, y: float, path: str) -> None:
        post_drop(self.surface.handle, x, y, path)

    def post_click(self, x: float, y: float) -> None:
        post_mouse(self.surface.handle, EVENT_POINTER_DOWN, x, y)
        post_mouse(self.surface.handle, EVENT_POINTER_UP, x, y)

    def post_move(self, x: float, y: float) -> None:
        post_mouse(self.surface.handle, EVENT_POINTER_MOVE, x, y)

    def _drain(self) -> None:
        poll_events(self.surface.handle)
        count: int = event_count(self.surface.handle)
        i: int = 0
        while i < count:
            kind: int = event_kind(self.surface.handle, i)
            x: float = event_x(self.surface.handle, i)
            y: float = event_y(self.surface.handle, i)
            key_code: int = event_key(self.surface.handle, i)
            input_value: int = event_button(self.surface.handle, i)
            if kind == EVENT_KEY_DOWN or kind == EVENT_KEY_UP:
                input_value = event_modifiers(self.surface.handle, i)
            pointer_id: int = event_pointer_id(self.surface.handle, i)
            pointer_kind: int = event_pointer_kind(self.surface.handle, i)
            timestamp_ns: int = event_timestamp_ns(self.surface.handle, i)
            event_time: float = -1.0
            if timestamp_ns > 0:
                event_time = float(timestamp_ns) / 1000000000.0
            if kind == EVENT_WINDOW_FOCUS:
                set_active_window(self.surface.handle)
            if kind == EVENT_METRICS:
                self._apply_metrics(i)
            elif kind == EVENT_ENVIRONMENT_CHANGED:
                self._apply_environment(i)
            elif kind == EVENT_MEMORY_PRESSURE:
                self._apply_memory(i)
            elif kind == EVENT_LIFECYCLE:
                self._apply_lifecycle(i)
            elif kind == EVENT_SURFACE_CREATED or kind == EVENT_SURFACE_CHANGED or kind == EVENT_SURFACE_DESTROYED:
                self._apply_surface(kind, i)
            elif kind == EVENT_RESIZE:
                self._apply_legacy_resize(x, y)
            text: str = event_text(self.surface.handle, i)
            if kind == EVENT_TEXT_EDIT:
                self.pump.text_edit(
                    event_text_edit_value(self.surface.handle, i, _TEXT_EDIT_OPERATION),
                    text,
                    event_text_edit_value(self.surface.handle, i, _TEXT_EDIT_GENERATION),
                    event_text_edit_value(self.surface.handle, i, _TEXT_EDIT_REVISION),
                    event_text_edit_value(self.surface.handle, i, _TEXT_EDIT_FIRST),
                    event_text_edit_value(self.surface.handle, i, _TEXT_EDIT_SECOND)
                )
            else:
                self.pump.dispatch(kind, x, y, key_code, text, input_value, pointer_id, event_time, pointer_kind)
            if kind == EVENT_SYSTEM_BACK and (key_code == 0 or key_code == BACK_PHASE_COMMIT):
                system_back_result(self.surface.handle, self.pump.last_system_back_handled)
            i = i + 1
        clear_events(self.surface.handle)

    def _apply_lifecycle(self, index: int) -> None:
        state: int = event_lifecycle_state(self.surface.handle, index)
        self.last_lifecycle_reason = event_lifecycle_reason(self.surface.handle, index)
        self.lifecycle.transition(state)
        note_lifecycle_state(state)
        self.pump.apply_lifecycle(state)

    def _apply_memory(self, index: int) -> None:
        level: int = event_memory_level(self.surface.handle, index)
        if level <= 0:
            return
        self.memory_pressure_level = level
        self.lifecycle.notify_memory_pressure(level)

    def _environment(self, index: int, field: int) -> float:
        return event_environment_value(self.surface.handle, index, field)

    def _read_cutouts(self, index: int) -> list[CutoutRect]:
        cutouts: list[CutoutRect] = []
        count: int = int(self._metric(index, _METRIC_CUTOUT_COUNT))
        i: int = 0
        if count < 0:
            count = 0
        if count > 8:
            count = 8
        while i < count:
            cutouts.append(CutoutRect(event_cutout_value(self.surface.handle, index, i, _CUTOUT_X), event_cutout_value(self.surface.handle, index, i, _CUTOUT_Y), event_cutout_value(self.surface.handle, index, i, _CUTOUT_WIDTH), event_cutout_value(self.surface.handle, index, i, _CUTOUT_HEIGHT)))
            i = i + 1
        return cutouts

    def _apply_environment(self, index: int) -> None:
        locales: str = event_text(self.surface.handle, index)
        locale: str = self.metrics.locale
        locale_list: str = self.metrics.locale_list
        font_scale: float = self._environment(index, _ENV_FONT_SCALE)
        if locales != "":
            locale = primary_locale(locales)
            locale_list = locales
        if font_scale <= 0.0:
            font_scale = self.metrics.font_scale
        self.metrics_revision = self.metrics_revision + 1
        self._replace_metrics(WindowMetrics(
            self.metrics.logical_width,
            self.metrics.logical_height,
            self.metrics.physical_width,
            self.metrics.physical_height,
            self.metrics.device_pixel_ratio,
            self.metrics.refresh_rate,
            self.metrics.view_padding,
            self.metrics.view_insets,
            self.metrics.system_gesture_insets,
            self.metrics.orientation,
            font_scale,
            int(self._environment(index, _ENV_BRIGHTNESS)),
            int(self._environment(index, _ENV_HIGH_CONTRAST)),
            locale,
            int(self._environment(index, _ENV_TEXT_DIRECTION)),
            int(self._environment(index, _ENV_REDUCE_MOTION)),
            int(self._environment(index, _ENV_ACCESSIBLE_NAVIGATION)),
            self.metrics.rotation_degrees,
            int(self._environment(index, _ENV_BOLD_TEXT)),
            copy_cutouts(self.metrics.cutouts),
            self.metrics.keyboard_duration_s,
            self.metrics.keyboard_curve,
            locale_list,
            self.metrics_revision
        ))

    def _apply_surface(self, kind: int, index: int) -> None:
        generation: int = event_surface_value(self.surface.handle, index, _SURFACE_GENERATION)
        if generation <= 0 or generation < self.surface_generation:
            return
        self.surface_generation = generation
        available: bool = kind != EVENT_SURFACE_DESTROYED
        self.surface_available = available
        self.pump.apply_surface_available(available)

    def _metric(self, index: int, field: int) -> float:
        return event_metrics_value(self.surface.handle, index, field)

    def _apply_metrics(self, index: int) -> None:
        width: float = self._metric(index, _METRIC_LOGICAL_WIDTH)
        height: float = self._metric(index, _METRIC_LOGICAL_HEIGHT)
        scale: float = self._metric(index, _METRIC_DEVICE_PIXEL_RATIO)
        if width <= 0.0 or height <= 0.0 or scale <= 0.0:
            return
        refresh: float = self._metric(index, _METRIC_REFRESH_RATE)
        font_scale: float = self._metric(index, _METRIC_FONT_SCALE)
        orientation: int = int(self._metric(index, _METRIC_ORIENTATION))
        rotation: int = int(self._metric(index, _METRIC_ROTATION_DEGREES))
        if refresh <= 0.0:
            refresh = self.metrics.refresh_rate
        if font_scale <= 0.0:
            font_scale = self.metrics.font_scale
        if orientation == 0:
            if width > height:
                orientation = 2
            else:
                orientation = 1
        self.metrics_revision = self.metrics_revision + 1
        metrics: WindowMetrics = WindowMetrics(
            width,
            height,
            int(self._metric(index, _METRIC_PHYSICAL_WIDTH)),
            int(self._metric(index, _METRIC_PHYSICAL_HEIGHT)),
            scale,
            refresh,
            EdgeInsets(self._metric(index, _METRIC_VIEW_PADDING_LEFT), self._metric(index, _METRIC_VIEW_PADDING_TOP), self._metric(index, _METRIC_VIEW_PADDING_RIGHT), self._metric(index, _METRIC_VIEW_PADDING_BOTTOM)),
            EdgeInsets(self._metric(index, _METRIC_VIEW_INSET_LEFT), self._metric(index, _METRIC_VIEW_INSET_TOP), self._metric(index, _METRIC_VIEW_INSET_RIGHT), self._metric(index, _METRIC_VIEW_INSET_BOTTOM)),
            EdgeInsets(self._metric(index, _METRIC_SYSTEM_GESTURE_LEFT), self._metric(index, _METRIC_SYSTEM_GESTURE_TOP), self._metric(index, _METRIC_SYSTEM_GESTURE_RIGHT), self._metric(index, _METRIC_SYSTEM_GESTURE_BOTTOM)),
            orientation,
            font_scale,
            self.metrics.brightness,
            self.metrics.high_contrast,
            self.metrics.locale,
            self.metrics.text_direction,
            self.metrics.reduce_motion,
            self.metrics.accessible_navigation,
            rotation,
            self.metrics.bold_text,
            self._read_cutouts(index),
            self._metric(index, _METRIC_KEYBOARD_DURATION),
            int(self._metric(index, _METRIC_KEYBOARD_CURVE)),
            self.metrics.locale_list,
            self.metrics_revision
        )
        self._replace_metrics(metrics)

    def _apply_legacy_resize(self, width: float, height: float) -> None:
        if width <= 0.0 or height <= 0.0:
            return
        self.metrics_revision = self.metrics_revision + 1
        self._replace_metrics(resized_window_metrics(self.metrics, width, height, self.metrics_revision))

    def _replace_metrics(self, metrics: WindowMetrics) -> None:
        self.metrics = metrics
        self.width = int(metrics.logical_width)
        self.height = int(metrics.logical_height)
        self.pump.resize(metrics.logical_width, metrics.logical_height)
        self.pump.apply_reduce_motion(metrics.reduce_motion)
        self.pump.set_keyboard_inset(metrics.view_insets.bottom)
        self.pump.background = platform_theme(metrics).scheme.background
        edge: float = metrics.system_gesture_insets.left
        rtl: bool = metrics.text_direction == TEXT_DIRECTION_RTL
        if rtl:
            edge = metrics.system_gesture_insets.right
        self.pump.configure_interactive_back((capabilities(self.surface.handle) & CAPABILITY_INTERACTIVE_EDGE_BACK) != 0, edge, rtl)
        app: Widget | None = self.app
        root: Element | None = self.pump.root
        if app is not None and root is not None:
            root.update(WindowMetricsScope(metrics, SystemTheme(app)))


def canvas_of(binding: Binding) -> Canvas:
    return binding.surface.canvas


def _place_plugins(handle: int, box: RenderBox) -> None:
    only: RenderBox | None = box.only_child
    i: int = 0
    if box.plugin_id != 0:
        plugin_place(handle, box.plugin_id, box.absolute_x(), box.absolute_y(), box.width, box.height)
    if only is not None:
        _place_plugins(handle, only)
    while i < len(box.children):
        _place_plugins(handle, box.children[i])
        i = i + 1
