from aura.platform.bridge import listing_lock, listing_name_byte, listing_name_count, listing_name_len, listing_result_generation, listing_result_status, listing_submit, listing_unlock
from aura.widgets.framework import dirty_element_id

_listing_names: list[str] = []
_generation: int = 0
_applied: int = 0
_revision: int = 0
_status: int = 0
_owner: int = 0
_root: str = ""
_current: str = ""
_path_a: str = ""
_path_b: str = ""
_requested: str = ""
_names_a: list[str] = []
_names_b: list[str] = []


def bind_listing(element_id: int) -> None:
    _owner = element_id


def set_listing_root(path: str) -> None:
    _root = path
    _current = path


def listing_root() -> str:
    return _root


def listing_current() -> str:
    # Yol dizesini olduğu gibi widget'a vermek sonraki karede ayırıcıyı bozar.
    return _listing_piece(_current, "")


def listing_status() -> int:
    return _status


def listing_revision() -> int:
    return _revision


def listing_len() -> int:
    return len(_listing_names)


def listing_has(name: str) -> int:
    i: int = 0
    while i < len(_listing_names):
        if _listing_names[i] == name:
            return 1
        i = i + 1
    return 0


def entry_count() -> int:
    if _current != _root and _root != "":
        return len(_listing_names) + 1
    return len(_listing_names)


def entry_label(index: int) -> str:
    slot: int = index
    if _current != _root and _root != "":
        if index == 0:
            return ".."
        slot = index - 1
    if slot < 0 or slot >= len(_listing_names):
        return ""
    return _listing_names[slot]


def _dirty() -> None:
    if _owner != 0:
        dirty_element_id(_owner)


def _listing_piece(left: str, right: str) -> str:
    return left + right


def _decode(index: int) -> str:
    count: int = listing_name_len(index)
    text: str = ""
    i: int = 0
    b0: int = 0
    b1: int = 0
    b2: int = 0
    b3: int = 0
    while i < count:
        b0 = listing_name_byte(index, i)
        if b0 < 128:
            text = _listing_piece(text, chr(b0))
            i = i + 1
        elif b0 < 224 and i + 1 < count:
            b1 = listing_name_byte(index, i + 1)
            text = _listing_piece(text, chr(((b0 & 31) << 6) | (b1 & 63)))
            i = i + 2
        elif b0 < 240 and i + 2 < count:
            b1 = listing_name_byte(index, i + 1)
            b2 = listing_name_byte(index, i + 2)
            text = _listing_piece(text, chr(((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63)))
            i = i + 3
        elif i + 3 < count:
            b1 = listing_name_byte(index, i + 1)
            b2 = listing_name_byte(index, i + 2)
            b3 = listing_name_byte(index, i + 3)
            text = _listing_piece(text, chr(((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63)))
            i = i + 4
        else:
            text = _listing_piece(text, chr(b0))
            i = i + 1
    return text


def _keep_path(path: str) -> None:
    _path_b = _path_a
    _path_a = path


def _keep_names(names: list[str]) -> None:
    _names_b = _names_a
    _names_a = names


def start_listing(path: str) -> None:
    blank: list[str] = []
    _generation = _generation + 1
    _keep_path(_requested)
    _keep_names(_listing_names)
    _requested = path
    _status = 0
    _listing_names = blank
    _revision = _revision + 1
    if listing_submit(_generation, path) == 0:
        _status = 2
        _dirty()
        return
    _dirty()


def apply_listing() -> None:
    gen: int = 0
    status: int = 0
    count: int = 0
    i: int = 0
    names: list[str] = []
    listing_lock()
    gen = listing_result_generation()
    status = listing_result_status()
    if gen != _generation or status == 0 or gen == _applied:
        listing_unlock()
        return
    count = listing_name_count()
    while i < count:
        names.append(_decode(i))
        i = i + 1
    listing_unlock()
    _applied = gen
    _status = status
    _keep_path(_current)
    _current = _requested
    _keep_names(_listing_names)
    _listing_names = names
    _revision = _revision + 1
    _dirty()
