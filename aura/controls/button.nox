from aura.foundation.color import COLOR_BUTTON, COLOR_BUTTON_TEXT
from aura.rendering.layer import PaintingContext
from aura.rendering.render_object import RenderBox
from aura.semantics.semantics_node import SemanticsNode
from aura.text.measure import measure_height, measure_width
from aura.widgets.framework import Element, RenderObjectWidget
from aura.widgets.theme import theme_for_element
from aura.widgets.key import Key
from aura.widgets.type_ids import alloc_type_id

TYPE_BUTTON: int = alloc_type_id()

BUTTON_PAD_X: float = 18.0
BUTTON_PAD_Y: float = 10.0
BUTTON_ALIGN_CENTER: int = 0
BUTTON_ALIGN_START: int = 1


def _quiet_secondary(x: float, y: float) -> None:
    if x == 0.0 and y == 0.0:
        return


def _quiet_file(path: str) -> None:
    if path == "":
        return


class RenderButton(RenderBox):
    label: str
    font_size: float
    color: int
    background: int
    text_align: int

    def __init__(self) -> None:
        super().__init__()
        self.label = ""
        self.font_size = 16.0
        self.color = COLOR_BUTTON_TEXT
        self.background = COLOR_BUTTON
        self.text_align = BUTTON_ALIGN_CENTER
        self.semantics_role = "button"

    def set_button(self, label: str, font_size: float, color: int, background: int, text_align: int) -> None:
        changed: bool = False
        if self.label != label or self.font_size != font_size or self.color != color or self.background != background or self.text_align != text_align:
            changed = True
        self.label = label
        self.font_size = font_size
        self.color = color
        self.background = background
        self.text_align = text_align
        self.semantics_role = "button"
        self.semantics_label = label
        self.takes_focus = True
        if changed:
            self.mark_needs_layout()

    def perform_layout(self) -> None:
        text_w: float = measure_width(self.label, self.font_size, 600, "")
        text_h: float = measure_height(self.font_size, 600, "")
        self.width = self.constraints.constrain_width(text_w + BUTTON_PAD_X * 2.0)
        self.height = self.constraints.constrain_height(text_h + BUTTON_PAD_Y * 2.0)

    def paint_self(self, context: PaintingContext) -> None:
        context.fill_rect(0.0, 0.0, self.width, self.height, self.background)
        text_w: float = measure_width(self.label, self.font_size, 600, "")
        text_h: float = measure_height(self.font_size, 600, "")
        x: float = (self.width - text_w) / 2.0
        y: float = (self.height - text_h) / 2.0
        if self.text_align == BUTTON_ALIGN_START:
            x = BUTTON_PAD_X
        if x < 0.0:
            x = 0.0
        context.fill_text(x, y, self.label, self.font_size, 600, self.color, "")

    def hit_test_self(self, x: float, y: float) -> bool:
        return True

    def describe_semantics(self, node: SemanticsNode) -> None:
        node.role = "button"
        node.label = self.label
        node.value = ""
        node.enabled = True
        node.checked = False
        node.add_action("tap")


class Button(RenderObjectWidget):
    label: str
    on_press: () -> None
    font_size: float
    color: int
    background: int
    has_colors: int
    text_align: int
    on_secondary: (float, float) -> None
    has_secondary: int
    file_path: str
    on_file_drag: (str) -> None
    has_file_drag: int

    def __init__(self, label: str, on_press: () -> None, font_size: float = 16.0, color: int | None = None, background: int | None = None, text_align: int = 0, key: Key | None = None) -> None:
        super().__init__(TYPE_BUTTON, key)
        self.label = label
        self.on_press = on_press
        self.font_size = font_size
        self.color = 0
        self.background = 0
        self.has_colors = 0
        self.text_align = text_align
        self.on_secondary = _quiet_secondary
        self.has_secondary = 0
        self.file_path = ""
        self.on_file_drag = _quiet_file
        self.has_file_drag = 0
        if color is not None:
            if background is not None:
                self.color = color
                self.background = background
                self.has_colors = 1

    def with_secondary(self, handler: (float, float) -> None) -> Button:
        self.on_secondary = handler
        self.has_secondary = 1
        return self

    def with_file(self, path: str, handler: (str) -> None) -> Button:
        self.file_path = path
        self.on_file_drag = handler
        if path == "":
            self.has_file_drag = 0
        else:
            self.has_file_drag = 1
        return self

    def create_render(self) -> RenderBox | None:
        return RenderButton()

    def sync_render(self, element: Element) -> None:
        element.remember_press(self.on_press)
        element.ensure_button_focus()
        color: int = self.color
        background: int = self.background
        if self.has_colors == 0:
            color = theme_for_element(element).scheme.button_text
            background = theme_for_element(element).scheme.button
        element.apply_button(self.label, self.font_size, color, background, self.text_align, element.press_and_focus)
        if self.has_secondary == 1:
            element.apply_secondary(self.on_secondary)
        else:
            element.clear_secondary()
        if self.has_file_drag == 1:
            element.apply_file_drag(self.file_path, self.on_file_drag)
        else:
            element.clear_file_drag()
