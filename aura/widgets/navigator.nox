from aura.core.diagnostics import FrameworkError
from aura.foundation.constraints import Constraints
from aura.rendering.layer import PaintingContext
from aura.rendering.render_object import HitTestResult, RenderBox
from aura.widgets.framework import BuildContext, Element, RenderElement, StatelessWidget, Widget
from aura.widgets.key import IntValueKey, Key
from aura.widgets.platform_route import PlatformRouteRequest
from aura.runtime.route_store import persisted_route_snapshot, persist_route_snapshot, set_route_save_hook
from aura.widgets.route_restoration import ROUTE_STACK_VERSION, RouteStackSnapshot, decode_route_stack
from aura.widgets.type_ids import alloc_type_id

TYPE_NAVIGATOR: int = alloc_type_id()
TYPE_ROUTE_HOST: int = alloc_type_id()


def _ignore_platform_route(request: PlatformRouteRequest) -> Widget | None:
    return None


def _ignore_restoration(name: str) -> Widget | None:
    if len(name) < 0:
        return None
    return None


_nav_ids: list[int] = []
_nav_elements: list[Element] = []


def save_mounted_navigators() -> None:
    i: int = 0
    while i < len(_nav_elements):
        element: Element = _nav_elements[i]
        if element.restoration_active() == 1 and not element.unmounted:
            names: list[str] = element.route_names()
            if len(names) > 0:
                persist_route_snapshot(RouteStackSnapshot(ROUTE_STACK_VERSION, names).encode())
            return
        i = i + 1


class Route:
    name: str
    route_id: int
    page: Widget

    def __init__(self, name: str, page: Widget) -> None:
        self.name = name
        self.route_id = 0
        self.page = page


class NavEntry:
    name: str
    route_id: int
    page: Widget

    def __init__(self, name: str, route_id: int, page: Widget) -> None:
        self.name = name
        self.route_id = route_id
        self.page = page


def register_navigator(element: Element) -> None:
    set_route_save_hook(save_mounted_navigators)
    i: int = 0
    while i < len(_nav_ids):
        if _nav_ids[i] == element.element_id:
            _nav_elements[i] = element
            return
        i = i + 1
    _nav_ids.append(element.element_id)
    _nav_elements.append(element)


def unregister_navigator(element_id: int) -> None:
    ids: list[int] = []
    elements: list[Element] = []
    i: int = 0
    while i < len(_nav_ids):
        if _nav_ids[i] != element_id:
            ids.append(_nav_ids[i])
            elements.append(_nav_elements[i])
        i = i + 1
    _nav_ids = ids
    _nav_elements = elements


def _navigator_at(element_id: int) -> Element | None:
    i: int = 0
    while i < len(_nav_ids):
        if _nav_ids[i] == element_id:
            return _nav_elements[i]
        i = i + 1
    return None


class NavigatorHandle:
    element_id: int

    def __init__(self, element_id: int) -> None:
        self.element_id = element_id

    def push(self, route: Route) -> None:
        found: Element | None = _navigator_at(self.element_id)
        if found is None:
            return
        found.push_page(route.name, route.page)

    def pop(self) -> None:
        found: Element | None = _navigator_at(self.element_id)
        if found is None:
            return
        found.pop_page()

    def replace(self, route: Route) -> None:
        found: Element | None = _navigator_at(self.element_id)
        if found is None:
            return
        found.replace_page(route.name, route.page)

    def can_pop(self) -> bool:
        found: Element | None = _navigator_at(self.element_id)
        if found is None:
            return False
        if found.can_pop_page() == 1:
            return True
        return False

    def snapshot(self) -> RouteStackSnapshot:
        found: Element | None = _navigator_at(self.element_id)
        if found is None:
            raise FrameworkError("navigator is not mounted")
        return RouteStackSnapshot(ROUTE_STACK_VERSION, found.route_names())


def _lookup(element: Element, depend: int) -> NavigatorHandle:
    parent: Element | None = element.parent
    while parent is not None:
        found: Element | None = _navigator_at(parent.element_id)
        if found is not None:
            if depend == 1:
                parent.add_dependent(element)
            return NavigatorHandle(parent.element_id)
        parent = parent.parent
    raise Exception("Navigator.of called without a navigator")


def navigator_of(context: BuildContext) -> NavigatorHandle:
    return _lookup(context.element, 1)


def navigator_handle(context: BuildContext) -> NavigatorHandle:
    return _lookup(context.element, 0)


def pop_system_route(root: Element) -> bool:
    return root.handle_system_route_back() == 1


class RenderNavigator(RenderBox):
    active: int
    interactive: bool
    interactive_progress: float

    def __init__(self) -> None:
        super().__init__()
        self.multi_child = True
        self.active = 0
        self.interactive = False
        self.interactive_progress = 0.0

    def set_active_index(self, index: int) -> None:
        if self.active == index:
            return
        self.active = index
        self.mark_needs_layout()

    def begin_interactive_pop(self) -> int:
        if self.interactive or self.active <= 0 or self.active >= len(self.children):
            return 0
        self.interactive = True
        self.interactive_progress = 0.0
        self.mark_needs_layout()
        return 1

    def update_interactive_pop(self, progress: float) -> None:
        if not self.interactive:
            return
        value: float = progress
        if value < 0.0:
            value = 0.0
        if value > 1.0:
            value = 1.0
        if value == self.interactive_progress:
            return
        self.interactive_progress = value
        self.mark_needs_paint()

    def end_interactive_pop(self) -> None:
        if not self.interactive:
            return
        self.interactive = False
        self.interactive_progress = 0.0
        self.mark_needs_layout()

    def perform_layout(self) -> None:
        self.width = self.constraints.constrain_width(self.constraints.max_width)
        self.height = self.constraints.constrain_height(self.constraints.max_height)
        limits: Constraints = Constraints(self.width, self.width, self.height, self.height)
        i: int = 0
        while i < len(self.children):
            if i == self.active or (self.interactive and i == self.active - 1):
                child: RenderBox = self.children[i]
                child.layout(limits)
                child.offset_x = 0.0
                child.offset_y = 0.0
            i = i + 1

    def paint_children(self, context: PaintingContext) -> None:
        if self.active < 0 or self.active >= len(self.children):
            return
        if self.interactive and self.active > 0:
            previous_x: float = -self.width * 0.25 * (1.0 - self.interactive_progress)
            context.push_offset(previous_x, 0.0)
            self.children[self.active - 1].paint(context)
            context.pop_offset(previous_x, 0.0)
            active_x: float = self.width * self.interactive_progress
            context.push_offset(active_x, 0.0)
            self.children[self.active].paint(context)
            context.pop_offset(active_x, 0.0)
            return
        self.paint_child(context, self.children[self.active])

    def hit_test_children(self, result: HitTestResult, x: float, y: float) -> bool:
        if self.active < 0 or self.active >= len(self.children):
            return False
        return self.children[self.active].hit_test(result, x, y)


class RouteHost(StatelessWidget):
    page: Widget

    def __init__(self, page: Widget, route_id: int) -> None:
        super().__init__(TYPE_ROUTE_HOST, IntValueKey(route_id))
        self.page = page

    def build(self, context: BuildContext) -> Widget:
        return self.page


class NavigatorElement(RenderElement):
    entries: list[NavEntry]
    next_route_id: int
    ready: int
    interactive_pop: bool
    restoration_enabled: int
    platform_route_resolver: (PlatformRouteRequest) -> Widget | None
    restoration_resolver: (str) -> Widget | None

    def __init__(self) -> None:
        super().__init__()
        self.entries = []
        self.next_route_id = 1
        self.ready = 0
        self.interactive_pop = False
        self.restoration_enabled = 0
        self.platform_route_resolver = _ignore_platform_route
        self.restoration_resolver = _ignore_restoration

    def first_mount(self) -> None:
        widget: Widget | None = self.widget
        if widget is None:
            return
        created: RenderBox | None = widget.create_render()
        if created is None:
            return
        self.render = created
        if self.pipeline is not None:
            created.pipeline = self.pipeline
        register_navigator(self)
        widget.seed_navigator(self)
        self.rebuild()

    def update(self, widget: Widget) -> None:
        self.widget = widget
        self.rebuild()
        self.notify_dependents()

    def rebuild(self) -> None:
        if self.unmounted:
            return
        self.rebuild_count = self.rebuild_count + 1
        hosts: list[Widget] = []
        i: int = 0
        while i < len(self.entries):
            hosts.append(RouteHost(self.entries[i].page, self.entries[i].route_id))
            i = i + 1
        self.reconcile(hosts)
        self.sync_render_children()
        box: RenderBox | None = self.render
        if box is not None:
            box.set_active_index(len(self.entries) - 1)

    def unmount(self) -> None:
        self._cancel_interactive_pop()
        unregister_navigator(self.element_id)
        super().unmount()

    def boot_home(self, page: Widget) -> None:
        if self.ready == 1:
            return
        self.ready = 1
        self._add("home", page)

    def push_page(self, name: str, page: Widget) -> None:
        self._cancel_interactive_pop()
        self._add(name, page)
        self.mark_dirty()

    def pop_page(self) -> None:
        self._cancel_interactive_pop()
        if len(self.entries) <= 1:
            return
        kept: list[NavEntry] = []
        i: int = 0
        while i < len(self.entries) - 1:
            kept.append(self.entries[i])
            i = i + 1
        self.entries = kept
        self.mark_dirty()

    def replace_page(self, name: str, page: Widget) -> None:
        self._cancel_interactive_pop()
        if len(self.entries) == 0:
            self._add(name, page)
        else:
            last: int = len(self.entries) - 1
            self.entries[last] = NavEntry(name, self._take_id(), page)
        self.mark_dirty()

    def can_pop_page(self) -> int:
        if len(self.entries) > 1:
            return 1
        return 0

    def route_names(self) -> list[str]:
        names: list[str] = []
        i: int = 0
        while i < len(self.entries):
            names.append(self.entries[i].name)
            i = i + 1
        return names

    def handle_system_overlay_back(self) -> int:
        if len(self.children) == 0:
            return 0
        return self.children[len(self.children) - 1].handle_system_overlay_back()

    def handle_system_route_back(self) -> int:
        self._cancel_interactive_pop()
        if len(self.children) > 0:
            if self.children[len(self.children) - 1].handle_system_route_back() == 1:
                return 1
        if self.can_pop_page() == 1:
            self.pop_page()
            return 1
        return 0

    def can_begin_interactive_route(self) -> int:
        if len(self.children) > 0:
            if self.children[len(self.children) - 1].can_begin_interactive_route() == 1:
                return 1
        if not self.interactive_pop and self.can_pop_page() == 1:
            return 1
        return 0

    def begin_interactive_route(self) -> int:
        if len(self.children) > 0:
            if self.children[len(self.children) - 1].begin_interactive_route() == 1:
                return 1
        if self.interactive_pop or self.can_pop_page() == 0:
            return 0
        box: RenderBox | None = self.render
        if box is None:
            return 0
        if box.begin_interactive_pop() == 0:
            return 0
        self.interactive_pop = True
        return 1

    def update_interactive_route(self, progress: float) -> int:
        if self.interactive_pop:
            box: RenderBox | None = self.render
            if box is not None:
                box.update_interactive_pop(progress)
            return 1
        if len(self.children) > 0:
            return self.children[len(self.children) - 1].update_interactive_route(progress)
        return 0

    def finish_interactive_route(self, commit: int) -> int:
        if self.interactive_pop:
            box: RenderBox | None = self.render
            if box is not None:
                box.end_interactive_pop()
            self.interactive_pop = False
            if commit == 1:
                self.pop_page()
            return 1
        if len(self.children) > 0:
            return self.children[len(self.children) - 1].finish_interactive_route(commit)
        return 0

    def set_platform_route_resolver(self, resolver: (PlatformRouteRequest) -> Widget | None) -> None:
        self.platform_route_resolver = resolver

    def restoration_active(self) -> int:
        if self.unmounted:
            return 0
        return self.restoration_enabled

    def set_restoration(self, resolver: (str) -> Widget | None, enabled: int) -> None:
        self.restoration_resolver = resolver
        self.restoration_enabled = enabled

    def restore_encoded(self, encoded: str) -> int:
        decoded: RouteStackSnapshot | None = None
        routes: list[str] = []
        pages: list[Widget] = []
        kept: list[NavEntry] = []
        i: int = 0
        if self.restoration_enabled == 0 or encoded == "" or len(self.entries) == 0:
            return 0
        try:
            decoded = decode_route_stack(encoded)
        except FrameworkError:
            return 0
        if decoded is None:
            return 0
        routes = decoded.routes
        if len(routes) == 0 or routes[0] != self.entries[0].name:
            return 0
        i = 1
        while i < len(routes):
            page: Widget | None = self.restoration_resolver(routes[i])
            if page is None:
                return 0
            pages.append(page)
            i = i + 1
        kept.append(self.entries[0])
        i = 0
        while i < len(pages):
            kept.append(NavEntry(routes[i + 1], self._take_id(), pages[i]))
            i = i + 1
        self.entries = kept
        self.mark_dirty()
        return 1

    def handle_platform_route(self, request: PlatformRouteRequest) -> int:
        self._cancel_interactive_pop()
        if len(self.children) > 0:
            if self.children[len(self.children) - 1].handle_platform_route(request) == 1:
                return 1
        page: Widget | None = self.platform_route_resolver(request)
        if page is None:
            return 0
        self.push_page(request.location, page)
        return 1

    def _cancel_interactive_pop(self) -> None:
        if not self.interactive_pop:
            return
        box: RenderBox | None = self.render
        if box is not None:
            box.end_interactive_pop()
        self.interactive_pop = False

    def sync_focus_geometry(self) -> None:
        if len(self.children) == 0:
            return
        self.children[len(self.children) - 1].sync_focus_geometry()

    def _add(self, name: str, page: Widget) -> None:
        self.entries.append(NavEntry(name, self._take_id(), page))

    def _take_id(self) -> int:
        route_id: int = self.next_route_id
        self.next_route_id = self.next_route_id + 1
        return route_id


class Navigator(StatelessWidget):
    home: Widget
    restoration_enabled: int
    platform_route_resolver: (PlatformRouteRequest) -> Widget | None
    restoration_resolver: (str) -> Widget | None

    def __init__(self, home: Widget, key: Key | None = None) -> None:
        super().__init__(TYPE_NAVIGATOR, key)
        self.home = home
        self.restoration_enabled = 0
        self.platform_route_resolver = _ignore_platform_route
        self.restoration_resolver = _ignore_restoration

    def with_platform_routes(self, resolver: (PlatformRouteRequest) -> Widget | None) -> Navigator:
        self.platform_route_resolver = resolver
        return self

    def with_restoration(self, resolver: (str) -> Widget | None) -> Navigator:
        self.restoration_resolver = resolver
        self.restoration_enabled = 1
        return self

    def create_element(self) -> Element:
        return NavigatorElement()

    def create_render(self) -> RenderBox | None:
        return RenderNavigator()

    def seed_navigator(self, element: Element) -> None:
        element.set_platform_route_resolver(self.platform_route_resolver)
        element.set_restoration(self.restoration_resolver, self.restoration_enabled)
        element.boot_home(self.home)
        if self.restoration_enabled == 1:
            element.restore_encoded(persisted_route_snapshot())
