from aura.rendering.render_object import RenderBox
from aura.widgets.framework import Element, RenderObjectWidget, Widget
from aura.widgets.key import Key
from aura.widgets.type_ids import alloc_type_id

TYPE_MOUSE_REGION: int = alloc_type_id()

CURSOR_ARROW: int = 0
CURSOR_TEXT: int = 1
CURSOR_HAND: int = 2


class RenderMouseRegion(RenderBox):
    def __init__(self) -> None:
        super().__init__()

    def perform_layout(self) -> None:
        child: RenderBox | None = self.only_child
        if child is not None:
            child.layout(self.constraints)
            child.offset_x = 0.0
            child.offset_y = 0.0
            self.width = self.constraints.constrain_width(child.width)
            self.height = self.constraints.constrain_height(child.height)
        else:
            self.width = self.constraints.constrain_width(self.constraints.min_width)
            self.height = self.constraints.constrain_height(self.constraints.min_height)

    def hit_test_self(self, x: float, y: float) -> bool:
        if x == y:
            return True
        return True


class MouseRegion(RenderObjectWidget):
    child: Widget
    on_enter: () -> None
    on_exit: () -> None
    cursor: int

    def __init__(self, child: Widget, on_enter: () -> None, on_exit: () -> None, cursor: int = 0, key: Key | None = None) -> None:
        super().__init__(TYPE_MOUSE_REGION, key)
        self.child = child
        self.on_enter = on_enter
        self.on_exit = on_exit
        self.cursor = cursor

    def create_render(self) -> RenderBox | None:
        return RenderMouseRegion()

    def child_widgets(self) -> list[Widget]:
        return [self.child]

    def sync_render(self, element: Element) -> None:
        box: RenderBox | None = element.render
        if box is None:
            return
        box.set_hover(element.element_id, self.on_enter, self.on_exit, self.cursor)
