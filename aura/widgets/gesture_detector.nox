from aura.rendering.render_object import RenderBox
from aura.widgets.framework import Element, RenderObjectWidget, Widget
from aura.widgets.key import Key
from aura.widgets.type_ids import alloc_type_id

TYPE_GESTURE: int = alloc_type_id()
PAN_FREE: int = 0
PAN_HORIZONTAL: int = 1
PAN_VERTICAL: int = 2


def _quiet_secondary(x: float, y: float) -> None:
    if x == 0.0 and y == 0.0:
        return


def _quiet_tap() -> None:
    pass


def _quiet_pan(x: float, y: float) -> None:
    if x == y:
        return


def _quiet_scale(value: float) -> None:
    if value < 0.0:
        return


class RenderGestureDetector(RenderBox):
    def __init__(self) -> None:
        super().__init__()

    def perform_layout(self) -> None:
        child: RenderBox | None = self.only_child
        if child is not None:
            child.layout(self.constraints)
            child.offset_x = 0.0
            child.offset_y = 0.0
            self.width = self.constraints.constrain_width(child.width)
            self.height = self.constraints.constrain_height(child.height)
        else:
            self.width = self.constraints.constrain_width(self.constraints.min_width)
            self.height = self.constraints.constrain_height(self.constraints.min_height)

    def hit_test_self(self, x: float, y: float) -> bool:
        return True


class GestureDetector(RenderObjectWidget):
    child: Widget
    on_tap: () -> None
    on_secondary: (float, float) -> None
    has_secondary: int
    on_double_tap: () -> None
    has_double_tap: int
    on_long_press: () -> None
    has_long_press: int
    on_pan: (float, float) -> None
    has_pan: int
    pan_axis: int
    on_scale: (float) -> None
    has_scale: int
    label: str

    def __init__(self, child: Widget, on_tap: () -> None, label: str = "", key: Key | None = None) -> None:
        super().__init__(TYPE_GESTURE, key)
        self.child = child
        self.on_tap = on_tap
        self.on_secondary = _quiet_secondary
        self.has_secondary = 0
        self.on_double_tap = _quiet_tap
        self.has_double_tap = 0
        self.on_long_press = _quiet_tap
        self.has_long_press = 0
        self.on_pan = _quiet_pan
        self.has_pan = 0
        self.pan_axis = PAN_FREE
        self.on_scale = _quiet_scale
        self.has_scale = 0
        self.label = label

    def listen_secondary(self, handler: (float, float) -> None) -> None:
        self.on_secondary = handler
        self.has_secondary = 1

    def with_double_tap(self, handler: () -> None) -> GestureDetector:
        self.on_double_tap = handler
        self.has_double_tap = 1
        return self

    def with_long_press(self, handler: () -> None) -> GestureDetector:
        self.on_long_press = handler
        self.has_long_press = 1
        return self

    def with_pan(self, handler: (float, float) -> None, axis: int = 0) -> GestureDetector:
        self.on_pan = handler
        self.has_pan = 1
        self.pan_axis = axis
        return self

    def with_scale(self, handler: (float) -> None) -> GestureDetector:
        self.on_scale = handler
        self.has_scale = 1
        return self

    def create_render(self) -> RenderBox | None:
        return RenderGestureDetector()

    def child_widgets(self) -> list[Widget]:
        return [self.child]

    def sync_render(self, element: Element) -> None:
        box: RenderBox | None = element.render
        if box is None:
            return
        box.set_tap(self.on_tap)
        box.semantics_role = "button"
        box.semantics_label = self.label
        if self.has_secondary == 1:
            box.set_secondary(self.on_secondary)
        else:
            box.clear_secondary()
        if self.has_double_tap == 1:
            box.set_double_tap(self.on_double_tap)
        else:
            box.clear_double_tap()
        if self.has_long_press == 1:
            box.set_long_press(self.on_long_press)
        else:
            box.clear_long_press()
        if self.has_pan == 1:
            box.set_pan(self.on_pan, self.pan_axis)
        else:
            box.clear_pan()
        if self.has_scale == 1:
            box.set_scale(self.on_scale)
        else:
            box.clear_scale()
