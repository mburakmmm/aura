def title_text(handle: int) -> str:
    count: int = aura_window_title_len(handle)
    if count < 0:
        raise FrameworkError("use after close")
    text: str = ""
    i: int = 0
    while i < count:
        b0: int = aura_window_title_byte(handle, i)
        b1: int = 0
        b2: int = 0
        b3: int = 0
        if b0 < 128:
            text = text + chr(b0)
            i = i + 1
        elif b0 < 224 and i + 1 < count:
            b1 = aura_window_title_byte(handle, i + 1)
            text = text + chr(((b0 & 31) << 6) | (b1 & 63))
            i = i + 2
        elif b0 < 240 and i + 2 < count:
            b1 = aura_window_title_byte(handle, i + 1)
            b2 = aura_window_title_byte(handle, i + 2)
            text = text + chr(((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63))
            i = i + 3
        elif i + 3 < count:
            b1 = aura_window_title_byte(handle, i + 1)
            b2 = aura_window_title_byte(handle, i + 2)
            b3 = aura_window_title_byte(handle, i + 3)
            text = text + chr(((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63))
            i = i + 4
        else:
            text = text + chr(b0)
            i = i + 1
    return text


