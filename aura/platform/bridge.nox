from aura.core.diagnostics import FrameworkError

_active_window: int = 0


def create_window(width: int, height: int, title: str, visible: int) -> int:
    handle: int = aura_window_create(width, height, title, visible)
    if handle == 0:
        raise FrameworkError("failed to create window")
    return handle


def destroy_window(handle: int) -> None:
    aura_window_destroy(handle)


def poll_events(handle: int) -> int:
    count: int = aura_window_poll(handle)
    if count < 0:
        raise FrameworkError("use after close")
    return count


def event_count(handle: int) -> int:
    count: int = aura_window_event_count(handle)
    if count < 0:
        raise FrameworkError("use after close")
    return count


def event_kind(handle: int, index: int) -> int:
    return aura_window_event_kind(handle, index)


def event_x(handle: int, index: int) -> float:
    return aura_window_event_x(handle, index)


def event_y(handle: int, index: int) -> float:
    return aura_window_event_y(handle, index)


def event_key(handle: int, index: int) -> int:
    return aura_window_event_key(handle, index)


def event_button(handle: int, index: int) -> int:
    return aura_window_event_button(handle, index)


def clear_events(handle: int) -> None:
    code: int = aura_window_events_clear(handle)
    if code < 0:
        raise FrameworkError("use after close")


def should_close(handle: int) -> bool:
    if aura_window_should_close(handle) != 0:
        return True
    return False


def extent_width(handle: int) -> float:
    value: float = aura_window_width(handle)
    if value < 0.0:
        raise FrameworkError("use after close")
    return value


