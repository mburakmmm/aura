def text_width(text: str, size: float, weight: int, family: str) -> float:
    return aura_text_width(text, size, weight, family)


def text_height(size: float, weight: int, family: str) -> float:
    return aura_text_height(size, weight, family)


def post_mouse(handle: int, kind: int, x: float, y: float) -> None:
    code: int = aura_post_mouse(handle, kind, x, y)
    if code < 0:
        raise FrameworkError("use after close")


def event_text(handle: int, index: int) -> str:
    count: int = aura_window_event_text_len(handle, index)
    text: str = ""
    i: int = 0
    while i < count:
        b0: int = aura_window_event_text_byte(handle, index, i)
        b1: int = 0
        b2: int = 0
        b3: int = 0
        if b0 < 128:
            text = text + chr(b0)
            i = i + 1
        elif b0 < 224 and i + 1 < count:
            b1 = aura_window_event_text_byte(handle, index, i + 1)
            text = text + chr(((b0 & 31) << 6) | (b1 & 63))
            i = i + 2
        elif b0 < 240 and i + 2 < count:
            b1 = aura_window_event_text_byte(handle, index, i + 1)
            b2 = aura_window_event_text_byte(handle, index, i + 2)
            text = text + chr(((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63))
            i = i + 3
        elif i + 3 < count:
            b1 = aura_window_event_text_byte(handle, index, i + 1)
            b2 = aura_window_event_text_byte(handle, index, i + 2)
            b3 = aura_window_event_text_byte(handle, index, i + 3)
            text = text + chr(((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63))
            i = i + 4
        else:
            text = text + chr(b0)
            i = i + 1
    return text


def set_active_window(handle: int) -> None:
    _active_window = handle


def active_window() -> int:
    return _active_window


def text_input_active(enabled: int) -> None:
    handle: int = _active_window
    if handle == 0:
        return
    code: int = aura_text_focus(handle, enabled)
    if code < 0:
        raise FrameworkError("use after close")


def sync_text_input(text: str, start: int, length: int) -> None:
    handle: int = _active_window
    if handle == 0:
        return
    if aura_text_contents(handle, text) < 0:
        raise FrameworkError("use after close")
    if aura_text_selection(handle, start, length) < 0:
        raise FrameworkError("use after close")


def clipboard_set(text: str) -> None:
    if aura_clipboard_set(text) < 0:
        raise FrameworkError("clipboard write failed")


def clipboard_get() -> str:
    count: int = aura_clipboard_len()
    if count < 0:
        return ""
    text: str = ""
    i: int = 0
    while i < count:
        b0: int = aura_clipboard_byte(i)
        b1: int = 0
        b2: int = 0
        b3: int = 0
        if b0 < 128:
            text = text + chr(b0)
            i = i + 1
        elif b0 < 224 and i + 1 < count:
            b1 = aura_clipboard_byte(i + 1)
            text = text + chr(((b0 & 31) << 6) | (b1 & 63))
            i = i + 2
        elif b0 < 240 and i + 2 < count:
            b1 = aura_clipboard_byte(i + 1)
            b2 = aura_clipboard_byte(i + 2)
            text = text + chr(((b0 & 15) << 12) | ((b1 & 63) << 6) | (b2 & 63))
            i = i + 3
        elif i + 3 < count:
            b1 = aura_clipboard_byte(i + 1)
            b2 = aura_clipboard_byte(i + 2)
            b3 = aura_clipboard_byte(i + 3)
            text = text + chr(((b0 & 7) << 18) | ((b1 & 63) << 12) | ((b2 & 63) << 6) | (b3 & 63))
            i = i + 4
        else:
            text = text + chr(b0)
            i = i + 1
    return text


def open_image_file(path: str) -> int:
    handle: int = aura_image_open_file(path)
    if handle == 0:
        raise FrameworkError("failed to open image")
    return handle


def open_image_bytes(data: list[int]) -> int:
    if aura_image_buffer_reset() < 0:
        raise FrameworkError("failed to decode image")
    i: int = 0
    while i < len(data):
        if aura_image_buffer_byte(data[i]) < 0:
            raise FrameworkError("failed to decode image")
        i = i + 1
    handle: int = aura_image_buffer_commit()
    if handle == 0:
        raise FrameworkError("failed to decode image")
    return handle


def image_size_width(handle: int) -> int:
    value: int = aura_image_width(handle)
