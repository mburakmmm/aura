def ax_text(handle: int, index: int, field: int) -> str:
    count: int = aura_ax_text_len(handle, index, field)
    if count < 0:
        raise FrameworkError("use after close")
    text: str = ""
    i: int = 0
    while i < count:
        text = text + chr(aura_ax_text_byte(i))
        i = i + 1
    return text


