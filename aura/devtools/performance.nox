from aura.runtime.frame import FramePump


def slowest_phase(pump: FramePump) -> str:
    name: str = "build"
    best: float = pump.build_ms
    if pump.layout_ms > best:
        best = pump.layout_ms
        name = "layout"
    if pump.paint_ms > best:
        best = pump.paint_ms
        name = "paint"
    if pump.composite_ms > best:
        name = "composite"
    return name


def format_frame(pump: FramePump) -> str:
    return "build_ms=" + str(pump.build_ms) + " layout_ms=" + str(pump.layout_ms) + " paint_ms=" + str(pump.paint_ms) + " composite_ms=" + str(pump.composite_ms) + " widgets_built=" + str(pump.widgets_built) + " elements_updated=" + str(pump.elements_updated) + " laid_out=" + str(pump.laid_out) + " painted=" + str(pump.painted) + " layers=" + str(pump.layers) + " budget_60_ms=16.67 budget_120_ms=8.33 slowest=" + slowest_phase(pump)
