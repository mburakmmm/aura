_SPACING_MARK_RANGES: list[int] = [2307, 2307, 2363, 2363, 2366, 2368, 2377, 2380, 2382, 2383, 2434, 2435, 2494, 2496, 2503, 2504, 2507, 2508, 2519, 2519, 2563, 2563, 2622, 2624, 2691, 2691, 2750, 2752, 2761, 2761, 2763, 2764, 2818, 2819, 2878, 2878, 2880, 2880, 2887, 2888, 2891, 2892, 2903, 2903, 3006, 3007, 3009, 3010, 3014, 3016, 3018, 3020, 3031, 3031, 3073, 3075, 3137, 3140, 3202, 3203, 3262, 3262, 3264, 3268, 3271, 3272, 3274, 3275, 3285, 3286, 3315, 3315, 3330, 3331, 3390, 3392, 3398, 3400, 3402, 3404, 3415, 3415, 3458, 3459, 3535, 3537, 3544, 3551, 3570, 3571, 3902, 3903, 3967, 3967, 4139, 4140, 4145, 4145, 4152, 4152, 4155, 4156, 4182, 4183, 4194, 4196, 4199, 4205, 4227, 4228, 4231, 4236, 4239, 4239, 4250, 4252, 5909, 5909, 5940, 5940, 6070, 6070, 6078, 6085, 6087, 6088, 6435, 6438, 6441, 6443, 6448, 6449, 6451, 6456, 6681, 6682, 6741, 6741, 6743, 6743, 6753, 6753, 6755, 6756, 6765, 6770, 6916, 6916, 6965, 6965, 6971, 6971, 6973, 6977, 6979, 6980, 7042, 7042, 7073, 7073, 7078, 7079, 7082, 7082, 7143, 7143, 7146, 7148, 7150, 7150, 7154, 7155, 7204, 7211, 7220, 7221, 7393, 7393, 7415, 7415, 12334, 12335, 43043, 43044, 43047, 43047, 43136, 43137, 43188, 43203, 43346, 43347, 43395, 43395, 43444, 43445, 43450, 43451, 43454, 43456, 43567, 43568, 43571, 43572, 43597, 43597, 43643, 43643, 43645, 43645, 43755, 43755, 43758, 43759, 43765, 43765, 44003, 44004, 44006, 44007, 44009, 44010, 44012, 44012, 69632, 69632, 69634, 69634, 69762, 69762, 69808, 69810, 69815, 69816, 69932, 69932, 69957, 69958, 70018, 70018, 70067, 70069, 70079, 70080, 70094, 70094, 70188, 70190, 70194, 70195, 70197, 70197, 70368, 70370, 70402, 70403, 70462, 70463, 70465, 70468, 70471, 70472, 70475, 70477, 70487, 70487, 70498, 70499, 70584, 70586, 70594, 70594, 70597, 70597, 70599, 70602, 70604, 70605, 70607, 70607, 70709, 70711, 70720, 70721, 70725, 70725, 70832, 70834, 70841, 70841, 70843, 70846, 70849, 70849, 71087, 71089, 71096, 71099, 71102, 71102, 71216, 71218, 71227, 71228, 71230, 71230, 71340, 71340, 71342, 71343, 71350, 71350, 71454, 71454, 71456, 71457, 71462, 71462, 71724, 71726, 71736, 71736, 71984, 71989, 71991, 71992, 71997, 71997, 72000, 72000, 72002, 72002, 72145, 72147, 72156, 72159, 72164, 72164, 72249, 72249, 72279, 72280, 72343, 72343, 72545, 72545, 72549, 72549, 72551, 72551, 72751, 72751, 72766, 72766, 72873, 72873, 72881, 72881, 72884, 72884, 73098, 73102, 73107, 73108, 73110, 73110, 73461, 73462, 73475, 73475, 73524, 73525, 73534, 73535, 73537, 73537, 90410, 90412, 94033, 94087, 94192, 94193, 119141, 119142, 119149, 119154]

_PROP_OTHER: int = 0
_PROP_CR: int = 1
_PROP_LF: int = 2
_PROP_CONTROL: int = 3
_PROP_EXTEND: int = 4
_PROP_ZWJ: int = 5
_PROP_SPACING_MARK: int = 6
_PROP_PREPEND: int = 7
_PROP_L: int = 8
_PROP_V: int = 9
_PROP_T: int = 10
_PROP_LV: int = 11
_PROP_LVT: int = 12


def _in_ranges(code: int, ranges: list[int]) -> bool:
    low: int = 0
    high: int = len(ranges) // 2 - 1
    while low <= high:
        middle: int = (low + high) // 2
        start: int = ranges[middle * 2]
        end: int = ranges[middle * 2 + 1]
        if code < start:
            high = middle - 1
        elif code > end:
            low = middle + 1
        else:
            return True
    return False


def _code_at(text: str, index: int) -> int:
    return ord(text[index:index + 1])


def _is_prepend(code: int) -> bool:
    return (code >= 1536 and code <= 1541) or code == 1757 or code == 1807 or code == 2192 or code == 2193 or code == 2274 or code == 3406 or code == 69821 or code == 69837 or code == 70082 or code == 70083 or code == 71999 or code == 72001 or code == 72250 or (code >= 72324 and code <= 72329) or code == 73030 or code == 73474 or (code >= 78896 and code <= 78911)


def _is_control(code: int) -> bool:
    return (code >= 0 and code <= 31) or (code >= 127 and code <= 159) or code == 173 or code == 1564 or code == 6158 or (code >= 8203 and code <= 8207) or (code >= 8232 and code <= 8238) or (code >= 8288 and code <= 8292) or (code >= 8294 and code <= 8303) or code == 65279 or (code >= 65529 and code <= 65531) or (code >= 113824 and code <= 113827) or code == 917505


def _is_extend(code: int) -> bool:
    if code == 8204 or (code >= 127995 and code <= 127999) or (code >= 917536 and code <= 917631):
        return True
    return _in_ranges(code, _EXTEND_RANGES)


def _hangul_property(code: int) -> int:
    if (code >= 4352 and code <= 4447) or (code >= 43360 and code <= 43388):
        return _PROP_L
    if (code >= 4448 and code <= 4519) or (code >= 55216 and code <= 55238):
        return _PROP_V
    if (code >= 4520 and code <= 4607) or (code >= 55243 and code <= 55291):
        return _PROP_T
    if code >= 44032 and code <= 55203:
        if (code - 44032) % 28 == 0:
            return _PROP_LV
        return _PROP_LVT
    return _PROP_OTHER


def _property(code: int) -> int:
    if code == 13:
        return _PROP_CR
    if code == 10:
        return _PROP_LF
    if code == 8205:
        return _PROP_ZWJ
    hangul: int = _hangul_property(code)
    if hangul != _PROP_OTHER:
        return hangul
    if _is_prepend(code):
        return _PROP_PREPEND
    if _is_extend(code):
        return _PROP_EXTEND
    if _in_ranges(code, _SPACING_MARK_RANGES):
        return _PROP_SPACING_MARK
    if _is_control(code):
        return _PROP_CONTROL
    return _PROP_OTHER


def _is_regional_indicator(code: int) -> bool:
    return code >= 127462 and code <= 127487


def _is_extended_pictographic(code: int) -> bool:
    if code == 169 or code == 174 or code == 8252 or code == 8265 or code == 8482 or code == 8505:
        return True
    if (code >= 8596 and code <= 8601) or code == 8617 or code == 8618 or code == 8986 or code == 8987 or code == 9000 or code == 9167 or (code >= 9193 and code <= 9203) or (code >= 9208 and code <= 9210) or code == 9410:
        return True
    if code == 9642 or code == 9643 or code == 9654 or code == 9664 or (code >= 9723 and code <= 9726) or (code >= 9728 and code <= 10175) or code == 10548 or code == 10549:
        return True
    if (code >= 11013 and code <= 11015) or code == 11035 or code == 11036 or code == 11088 or code == 11093 or code == 12336 or code == 12349 or code == 12951 or code == 12953:
        return True
    return (code >= 126976 and code <= 130047) or (code >= 130048 and code <= 131069)


def _emoji_before_zwj(text: str, zwj_index: int) -> bool:
    i: int = zwj_index - 1
    while i >= 0 and _property(_code_at(text, i)) == _PROP_EXTEND:
        i = i - 1
    return i >= 0 and _is_extended_pictographic(_code_at(text, i))


def is_grapheme_boundary(text: str, index: int) -> bool:
    count: int = len(text)
    if index <= 0 or index >= count:
        return True
    left_code: int = _code_at(text, index - 1)
    right_code: int = _code_at(text, index)
    left: int = _property(left_code)
    right: int = _property(right_code)
    if left == _PROP_CR and right == _PROP_LF:
        return False
    if left == _PROP_CR or left == _PROP_LF or left == _PROP_CONTROL:
        return True
    if right == _PROP_CR or right == _PROP_LF or right == _PROP_CONTROL:
        return True
    if left == _PROP_L and (right == _PROP_L or right == _PROP_V or right == _PROP_LV or right == _PROP_LVT):
        return False
    if (left == _PROP_LV or left == _PROP_V) and (right == _PROP_V or right == _PROP_T):
        return False
    if (left == _PROP_LVT or left == _PROP_T) and right == _PROP_T:
        return False
    if right == _PROP_EXTEND or right == _PROP_ZWJ or right == _PROP_SPACING_MARK:
        return False
    if left == _PROP_PREPEND:
        return False
    if left == _PROP_ZWJ and _is_extended_pictographic(right_code) and _emoji_before_zwj(text, index - 1):
        return False
    if _is_regional_indicator(left_code) and _is_regional_indicator(right_code):
        regional_count: int = 0
        i: int = index - 1
        while i >= 0 and _is_regional_indicator(_code_at(text, i)):
            regional_count = regional_count + 1
            i = i - 1
        return regional_count % 2 == 0
    return True


def previous_grapheme_boundary(text: str, index: int) -> int:
    point: int = index
    if point > len(text):
        point = len(text)
    if point <= 0:
        return 0
    point = point - 1
    while point > 0 and not is_grapheme_boundary(text, point):
        point = point - 1
    return point


def next_grapheme_boundary(text: str, index: int) -> int:
    point: int = index
    if point < 0:
        point = 0
    if point >= len(text):
        return len(text)
    point = point + 1
    while point < len(text) and not is_grapheme_boundary(text, point):
        point = point + 1
    return point


def floor_grapheme_boundary(text: str, index: int) -> int:
    point: int = index
    if point < 0:
        return 0
    if point >= len(text):
        return len(text)
    if is_grapheme_boundary(text, point):
        return point
    return previous_grapheme_boundary(text, point + 1)


def ceil_grapheme_boundary(text: str, index: int) -> int:
    point: int = index
    if point <= 0:
        return 0
    if point >= len(text):
        return len(text)
    if is_grapheme_boundary(text, point):
        return point
    return next_grapheme_boundary(text, point - 1)


def nearest_grapheme_boundary(text: str, index: int) -> int:
    left: int = floor_grapheme_boundary(text, index)
    right: int = ceil_grapheme_boundary(text, index)
    if index - left <= right - index:
        return left
    return right
