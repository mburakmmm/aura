from aura.platform.bridge import text_height, text_width


class TextLine:
    start: int
    end: int
    text: str

    def __init__(self, start: int, end: int, text: str) -> None:
        self.start = start
        self.end = end
        self.text = text


def measure_width(text: str, font_size: float, weight: int, family: str) -> float:
    return text_width(text, font_size, weight, family)


def measure_height(font_size: float, weight: int, family: str) -> float:
    return text_height(font_size, weight, family)


def line_for_offset(lines: list[TextLine], index: int, edge: int) -> int:
    count: int = len(lines)
    if count == 0:
        return 0
    i: int = 0
    while i < count:
        line: TextLine = lines[i]
        if index < line.start:
            return i
        if index < line.end:
            return i
        if index == line.end:
            if edge == 0:
                return i
            if i + 1 >= count:
                return i
            nxt: TextLine = lines[i + 1]
            if nxt.start > index:
                return i
        i = i + 1
    return count - 1


def _word_too_wide(word: str, max_width: float, font_size: float, weight: int, family: str) -> int:
    if word == "":
        return 0
    if max_width <= 0.0:
        return 1
    if measure_width(word, font_size, weight, family) > max_width:
        return 1
    return 0


def _break_word(text: str, start: int, end: int, max_width: float, font_size: float, weight: int, family: str) -> list[TextLine]:
    lines: list[TextLine] = []
    cursor: int = start
    while cursor < end:
        piece: int = cursor + 1
        while piece < end:
            if measure_width(text[cursor:piece + 1], font_size, weight, family) > max_width:
                break
            piece = piece + 1
        lines.append(TextLine(cursor, piece, text[cursor:piece]))
        cursor = piece
    return lines


def _paragraph(text: str, origin: int, para_end: int, max_width: float, font_size: float, weight: int, family: str) -> list[TextLine]:
    lines: list[TextLine] = []
    if origin == para_end:
        lines.append(TextLine(origin, origin, ""))
        return lines
    para: str = text[origin:para_end]
    words: list[str] = para.split(" ")
    current: str = ""
    current_start: int = origin
    pos: int = 0
    w: int = 0
    while w < len(words):
        word: str = words[w]
        word_at: int = origin + pos
        trial: str = word
        if current != "":
            trial = current + " " + word
        wide: int = _word_too_wide(word, max_width, font_size, weight, family)
        if wide == 1:
            if current != "":
                lines.append(TextLine(current_start, current_start + len(current), current))
            broken: list[TextLine] = _break_word(text, word_at, word_at + len(word), max_width, font_size, weight, family)
            k: int = 0
            while k < len(broken):
                lines.append(broken[k])
                k = k + 1
            current = ""
        elif current == "":
            current_start = word_at
            current = trial
        elif measure_width(trial, font_size, weight, family) <= max_width:
            current = trial
        else:
            lines.append(TextLine(current_start, current_start + len(current), current))
            current = word
            current_start = word_at
        pos = pos + len(word)
        if w + 1 < len(words):
            pos = pos + 1
        w = w + 1
    if current != "":
        lines.append(TextLine(current_start, current_start + len(current), current))
    return lines


def layout_lines(text: str, max_width: float, font_size: float, weight: int, family: str) -> list[TextLine]:
    lines: list[TextLine] = []
    if text == "":
        lines.append(TextLine(0, 0, ""))
        return lines
    length: int = len(text)
    origin: int = 0
    while origin <= length:
        para_end: int = origin
        while para_end < length:
            if text[para_end:para_end + 1] == "\n":
                break
            para_end = para_end + 1
        extra: list[TextLine] = _paragraph(text, origin, para_end, max_width, font_size, weight, family)
        n: int = 0
        while n < len(extra):
            lines.append(extra[n])
            n = n + 1
        if para_end >= length:
            break
        origin = para_end + 1
        if origin == length:
            lines.append(TextLine(origin, origin, ""))
            break
    if len(lines) == 0:
        lines.append(TextLine(0, 0, ""))
    return lines


def wrap_text(text: str, max_width: float, font_size: float, weight: int, family: str) -> list[str]:
    mapped: list[TextLine] = layout_lines(text, max_width, font_size, weight, family)
    lines: list[str] = []
    i: int = 0
    while i < len(mapped):
        lines.append(mapped[i].text)
        i = i + 1
    return lines
