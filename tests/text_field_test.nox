import nox.test
from aura.input.events import EVENT_IME_DELETE, EVENT_IME_INSERT, EVENT_IME_MARK, EVENT_KEY_DOWN
from aura.input.focus import FocusManager, FocusNode
from aura.platform.macos import clipboard_get, clipboard_set, set_cursor
from aura.rendering.render_object import RenderBox
from aura.runtime.binding import Binding
from aura.input.keyboard import KEY_A, KEY_BACKSPACE, KEY_DELETE, KEY_ENTER
from aura.text.editing import KEY_C, KEY_DOWN_ARROW, KEY_LEFT, KEY_RIGHT, KEY_UP_ARROW, KEY_V, KEY_X, MOD_COMMAND, MOD_SHIFT, TEXT_EDIT_COMMIT, TEXT_EDIT_DELETE_SURROUNDING, TEXT_EDIT_FINISH_COMPOSING, TEXT_EDIT_PERFORM_ACTION, TEXT_EDIT_SET_COMPOSING, TEXT_EDIT_SET_SELECTION, TextEditingController, TextEditingValue, deliver_key, deliver_text_edit
from aura.text.measure import measure_height, measure_width
from aura.text.input_configuration import CAPITALIZATION_WORDS, TEXT_ACTION_NEWLINE, TEXT_ACTION_SEND, TEXT_INPUT_EMAIL, TextInputConfiguration
from aura.testing.tester import WidgetTester
from aura.text.field import TextField


performed_action: int = -1


def note_action(action: int) -> None:
    performed_action = action


def require_box(box: RenderBox | None, name: str) -> RenderBox:
    if box is None:
        raise Exception(name)
    return box


plain: TextEditingController = TextEditingController("hi")
config: TextInputConfiguration = TextInputConfiguration(TEXT_INPUT_EMAIL, TEXT_ACTION_SEND, 0, 1, 0, CAPITALIZATION_WORDS, ["username", "emailAddress"])
nox.test.assert_eq_int(config.input_type, TEXT_INPUT_EMAIL, "typed input config keeps input type")
nox.test.assert_eq_int(config.action, TEXT_ACTION_SEND, "typed input config keeps action")
nox.test.assert_eq_int(config.secure, 1, "typed input config keeps secure policy")
nox.test.assert_eq_str(config.autofill_payload(), "username\nemailAddress", "autofill hints use bounded ABI payload")
plain.insert("!")
nox.test.assert_eq_str(plain.text, "hi!", "insert appends")
nox.test.assert_eq_int(plain.cursor, 3, "cursor follows insert")
plain.backspace()
nox.test.assert_eq_str(plain.text, "hi", "backspace removes one")
plain.backspace()
plain.backspace()
plain.backspace()
nox.test.assert_eq_str(plain.text, "", "backspace stops at the start")

keyed: TextEditingController = TextEditingController("ça")
keyed.begin_session()
keyed_focus: FocusManager = FocusManager()
keyed_node: FocusNode = FocusNode()
keyed_node.insert_target = keyed.target_id
keyed_focus.attach(keyed_node)
keyed_focus.focus(keyed_node)
deliver_key(keyed_focus, KEY_BACKSPACE, 0)
nox.test.assert_eq_str(keyed.text, "ç", "backspace key removes one grapheme")
keyed.collapse(0)
deliver_key(keyed_focus, KEY_DELETE, 0)
nox.test.assert_eq_str(keyed.text, "", "forward delete key removes the next grapheme")

session: TextEditingController = TextEditingController("abcd")
session.begin_session()
first_generation: int = session.generation
initial: TextEditingValue = session.editing_value()
nox.test.assert_eq_int(first_generation, 1, "first text session gets a generation")
nox.test.assert_eq_str(initial.text, "abcd", "editing value exposes committed text")
nox.test.assert_true(not initial.composing.is_valid(), "editing value starts without composition")
session_focus: FocusManager = FocusManager()
session_node: FocusNode = FocusNode()
session_node.insert_target = session.target_id
session_focus.attach(session_node)
session_focus.focus(session_node)
deliver_key(session_focus, KEY_A, MOD_COMMAND)
nox.test.assert_eq_str(session.selected_text(), "abcd", "select-all keyboard action selects committed text")
session.collapse(len(session.text))
platform_revision: int = session.editing_value().revision + 1
nox.test.assert_true(deliver_text_edit(session_focus, TEXT_EDIT_SET_COMPOSING, "xy", first_generation, platform_revision, 0, 0), "current composing revision is accepted")
composed: TextEditingValue = session.editing_value()
nox.test.assert_eq_str(session.text, "abcd", "composition does not mutate committed text")
nox.test.assert_eq_str(composed.text, "abcdxy", "editing buffer includes composition")
nox.test.assert_eq_int(composed.composing.start, 4, "composition range starts at caret")
nox.test.assert_eq_int(composed.composing.end, 6, "composition range covers marked text")
nox.test.assert_true(not deliver_text_edit(session_focus, TEXT_EDIT_COMMIT, "!", first_generation, platform_revision, 0, 0), "duplicate platform revision is rejected")
nox.test.assert_true(not deliver_text_edit(session_focus, TEXT_EDIT_COMMIT, "!", first_generation + 1, platform_revision + 1, 0, 0), "wrong generation is rejected")
nox.test.assert_true(not deliver_text_edit(session_focus, 99, "", first_generation, platform_revision + 1, 0, 0), "unknown operation is rejected")
nox.test.assert_true(deliver_text_edit(session_focus, TEXT_EDIT_FINISH_COMPOSING, "", first_generation, platform_revision + 1, 0, 0), "unknown operation does not consume revision")
nox.test.assert_eq_str(session.text, "abcdxy", "finishing composition commits marked text")
nox.test.assert_true(deliver_text_edit(session_focus, TEXT_EDIT_SET_SELECTION, "", first_generation, platform_revision + 2, 1, 3), "selection edit is accepted")
nox.test.assert_eq_int(session.sel_start(), 1, "platform selection start is applied")
nox.test.assert_eq_int(session.sel_end(), 3, "platform selection end is applied")
nox.test.assert_true(deliver_text_edit(session_focus, TEXT_EDIT_DELETE_SURROUNDING, "", first_generation, platform_revision + 3, 1, 1), "surrounding delete is accepted")
nox.test.assert_eq_str(session.text, "adxy", "surrounding delete first removes active selection")
session.end_session()
session.begin_session()
nox.test.assert_eq_int(session.generation, first_generation + 1, "new focus session invalidates old callbacks")
nox.test.assert_true(not deliver_text_edit(session_focus, TEXT_EDIT_COMMIT, "old", first_generation, platform_revision + 20, 0, 0), "late callback from old session is rejected")

regional: TextEditingController = TextEditingController("hello")
regional.begin_session()
regional.set_composing_region(1, 4)
regional_marked: TextEditingValue = regional.editing_value()
nox.test.assert_eq_str(regional.text, "hello", "marking an existing range keeps committed model text")
nox.test.assert_eq_str(regional_marked.text, "hello", "marked range starts from the editing buffer")
nox.test.assert_eq_int(regional_marked.composing.start, 1, "marked range start is retained")
nox.test.assert_eq_int(regional_marked.composing.end, 4, "marked range end is retained")
regional.set_composing("ipp")
nox.test.assert_eq_str(regional.editing_value().text, "hippo", "composing text replaces the marked editing range")
nox.test.assert_eq_str(regional.text, "hello", "replacement stays outside committed model until finish")
regional.finish_composing()
nox.test.assert_eq_str(regional.text, "hippo", "finish composition commits the editing buffer")
regional.set_composing_region(1, 4)
regional.set_composing("ey")
regional.end_session()
nox.test.assert_eq_str(regional.text, "hippo", "closing a session discards unfinished composition")
regional.replace_range(1, 4, "ey")
nox.test.assert_eq_str(regional.text, "heyo", "replace range commits a deterministic buffer edit")

action_controller: TextEditingController = TextEditingController("draft")
action_tester: WidgetTester = WidgetTester()
action_tester.pump_widget(TextField(action_controller, configuration=TextInputConfiguration(action=TEXT_ACTION_SEND)).with_action(note_action), 240.0, 80.0)
action_revision: int = action_controller.editing_value().revision + 1
nox.test.assert_true(deliver_text_edit(action_tester.pump.focus, TEXT_EDIT_PERFORM_ACTION, "", action_controller.generation, action_revision, TEXT_ACTION_SEND, 0), "platform editor action is accepted")
nox.test.assert_eq_int(performed_action, TEXT_ACTION_SEND, "platform editor action reaches the field callback")
nox.test.assert_eq_str(action_controller.text, "draft", "non-newline action does not mutate text")
deliver_key(action_tester.pump.focus, KEY_ENTER, 0)
nox.test.assert_eq_int(performed_action, TEXT_ACTION_SEND, "hardware enter uses the configured action")

newline_controller: TextEditingController = TextEditingController("line")
newline_tester: WidgetTester = WidgetTester()
newline_tester.pump_widget(TextField(newline_controller, configuration=TextInputConfiguration(action=TEXT_ACTION_NEWLINE, multiline=1)), 240.0, 160.0)
newline_revision: int = newline_controller.editing_value().revision + 1
nox.test.assert_true(deliver_text_edit(newline_tester.pump.focus, TEXT_EDIT_PERFORM_ACTION, "", newline_controller.generation, newline_revision, TEXT_ACTION_NEWLINE, 0), "newline editor action is accepted")
nox.test.assert_eq_str(newline_controller.text, "line\n", "newline action inserts text through the controller")

field: TextEditingController = TextEditingController("")
tester: WidgetTester = WidgetTester()
tester.pump_widget(TextField(field), 240.0, 80.0)
nox.test.assert_eq_str(field.text, "", "field starts empty")
nox.test.assert_true(field.session_active, "focused field owns an active text session")
field_generation: int = field.generation
tester.pump.focus.suspend_input()
nox.test.assert_true(not field.session_active, "background closes the text session")
tester.pump.focus.resume_input()
nox.test.assert_true(field.session_active, "foreground recreates the focused text session")
nox.test.assert_eq_int(field.generation, field_generation + 1, "recreated session gets a fresh generation")
tester.pump.dispatch(EVENT_IME_INSERT, 0.0, 0.0, 0, "ab")
tester.pump_frame()
nox.test.assert_eq_str(field.text, "ab", "insert event updates the controller")
box: RenderBox = require_box(tester.view().only_child, "field")
nox.test.assert_eq_str(box.semantics_label, "ab", "field paints the inserted text")
tester.pump.dispatch(EVENT_IME_MARK, 0.0, 0.0, 0, "c")
tester.pump_frame()
nox.test.assert_eq_str(field.composing, "c", "mark event stores composition")
tester.pump.dispatch(EVENT_IME_DELETE, 0.0, 0.0, 0, "")
tester.pump_frame()
nox.test.assert_eq_str(field.text, "a", "delete event removes one character")
nox.test.assert_eq_str(field.composing, "", "delete clears composition")

body: TextEditingController = TextEditingController("")
lines: WidgetTester = WidgetTester()
lines.pump_widget(TextField(body, multiline=1), 240.0, 160.0)
single_height: float = box.height
body.insert("one\ntwo")
lines.pump_frame()
wrapped: RenderBox = require_box(lines.view().only_child, "multiline")
nox.test.assert_true(wrapped.height > single_height, "multiline grows with a second line")

binding: Binding = Binding(800, 600, "Aura", 0)
native: TextEditingController = TextEditingController("")
binding.mount(TextField(native))
binding.frame()
binding.insert_text("nox")
binding.frame()
nox.test.assert_eq_str(native.text, "nox", "platform text queue reaches the field")
binding.close()

kept: str = clipboard_get()
sample: TextEditingController = TextEditingController("abcdef")
sample.anchor = 1
sample.cursor = 4
sample.copy()
nox.test.assert_eq_str(clipboard_get(), "bcd", "copy writes the selection")
sample.cut()
nox.test.assert_eq_str(sample.text, "aef", "cut removes the selection")
nox.test.assert_eq_int(sample.cursor, 1, "cut collapses the caret")
clipboard_set("XY")
sample.paste()
nox.test.assert_eq_str(sample.text, "aXYef", "paste replaces the caret")
sample.move_by(-1, 0)
nox.test.assert_eq_int(sample.cursor, 2, "left arrow moves the caret")
sample.move_by(-1, 1)
nox.test.assert_eq_int(sample.sel_start(), 1, "shift left extends the selection")
nox.test.assert_eq_int(sample.sel_end(), 2, "shift left keeps the anchor")
sample.insert("Z")
nox.test.assert_eq_str(sample.text, "aZYef", "typing replaces the selection")

placed: TextEditingController = TextEditingController("abcdef")
place: WidgetTester = WidgetTester()
place.pump_widget(TextField(placed), 240.0, 80.0)
glyph: float = measure_width("ab", 16.0, 400, "")
field_box: RenderBox = require_box(place.view().only_child, "place")
place.pump.pointer_down(field_box.absolute_x() + 8.0 + glyph, field_box.absolute_y() + 12.0)
place.pump.pointer_up(field_box.absolute_x() + 8.0 + glyph, field_box.absolute_y() + 12.0)
place.pump_frame()
nox.test.assert_eq_int(placed.cursor, 2, "click places the caret by glyph width")
nox.test.assert_eq_int(placed.anchor, 2, "click clears the selection")
far: float = measure_width("abcdef", 16.0, 400, "")
place.pump.pointer_down(field_box.absolute_x() + 8.0, field_box.absolute_y() + 12.0)
place.pump.pointer_move(field_box.absolute_x() + 8.0 + far, field_box.absolute_y() + 12.0)
place.pump.pointer_up(field_box.absolute_x() + 8.0 + far, field_box.absolute_y() + 12.0)
place.pump_frame()
nox.test.assert_eq_int(placed.sel_start(), 0, "drag selects from the press")
nox.test.assert_true(placed.sel_end() >= 4, "drag follows the pointer")
place.pump.dispatch(EVENT_KEY_DOWN, 0.0, 0.0, KEY_LEFT, "", MOD_SHIFT)
place.pump_frame()
nox.test.assert_true(placed.sel_end() > placed.sel_start(), "shift arrow keeps a selection")
place.pump.dispatch(EVENT_KEY_DOWN, 0.0, 0.0, KEY_RIGHT, "")
place.pump_frame()
nox.test.assert_eq_int(placed.anchor, placed.cursor, "plain arrow collapses the selection")
place.pump.dispatch(EVENT_KEY_DOWN, 0.0, 0.0, KEY_C, "", MOD_COMMAND)
place.pump.dispatch(EVENT_KEY_DOWN, 0.0, 0.0, KEY_X, "", MOD_COMMAND)
place.pump.dispatch(EVENT_KEY_DOWN, 0.0, 0.0, KEY_V, "", MOD_COMMAND)
place.pump_frame()
ship_w: float = measure_width("Ship", 16.0, 400, "")
pair_w: float = measure_width("Ship notes", 16.0, 400, "")
wrap_at: float = (ship_w + pair_w) / 2.0
edited: TextEditingController = TextEditingController("Ship notes")
arrows: WidgetTester = WidgetTester()
arrows.pump_widget(TextField(edited, multiline=1), wrap_at + 16.0, 160.0)
arrow_box: RenderBox = require_box(arrows.view().only_child, "arrows")
line_h: float = measure_height(16.0, 400, "")
second_y: float = arrow_box.absolute_y() + 8.0 + line_h + 2.0
arrows.pump.pointer_down(arrow_box.absolute_x() + 8.0, second_y)
arrows.pump.pointer_up(arrow_box.absolute_x() + 8.0, second_y)
arrows.pump_frame()
nox.test.assert_eq_int(edited.cursor, 5, "click on the wrapped line uses y")
arrows.pump.dispatch(EVENT_KEY_DOWN, 0.0, 0.0, KEY_UP_ARROW, "")
arrows.pump_frame()
nox.test.assert_eq_int(edited.cursor, 0, "up arrow keeps the column on the previous line")
arrows.pump.dispatch(EVENT_KEY_DOWN, 0.0, 0.0, KEY_DOWN_ARROW, "", MOD_SHIFT)
arrows.pump_frame()
nox.test.assert_eq_int(edited.sel_start(), 0, "shift down keeps the anchor")
nox.test.assert_true(edited.sel_end() > edited.sel_start(), "shift down extends onto the next line")
blank: TextEditingController = TextEditingController("The harbor is quiet")
blank_ui: WidgetTester = WidgetTester()
blank_ui.pump_widget(TextField(blank, multiline=1), 280.0, 240.0)
blank_box: RenderBox = require_box(blank_ui.view().only_child, "blank")
blank_ui.pump.pointer_down(blank_box.absolute_x() + 80.0, blank_box.absolute_y() + blank_box.height - 8.0, 1, 801, 20.0)
blank_ui.pump.arena.tick(20.2)
nox.test.assert_eq_int(blank.anchor, blank.cursor, "a tap in the empty field does not select")
blank_ui.pump.arena.tick(20.6)
nox.test.assert_true(blank.sel_end() > blank.sel_start(), "a hold selects the word at the caret")
nox.test.assert_true(blank.sel_end() - blank.sel_start() < len(blank.text), "a hold does not select the whole note")
blank_ui.pump.pointer_up(blank_box.absolute_x() + 80.0, blank_box.absolute_y() + blank_box.height - 8.0, 801, 20.7)
set_cursor(1)
set_cursor(0)
clipboard_set(kept)
print("text field ok")
